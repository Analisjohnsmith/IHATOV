#!/usr/bin/env python3
"""
FungeOS Core — Grid-based, pointer-driven game runtime
Part of FFX Generative Game Studio Platform
"""

import sys, os, time, random, json, hashlib
from collections import defaultdict
from typing import List, Dict, Tuple, Optional, Any

class FungeOS:
    def __init__(self, width=80, height=25):
        self.width = width
        self.height = height
        self.grid = [[' ' for _ in range(width)] for _ in range(height)]
        self.pointers = {}
        self.next_pid = 0
        self.cycles = 0
        self.start_time = time.time()
        self.seal = "🌀🕉️📚🌍∞"
        self.rom_name = "unknown"
        self.telemetry = []
    
    def load_rom(self, filename):
        try:
            with open(filename, 'r') as f:
                lines = f.readlines()
            for y, line in enumerate(lines):
                if y >= self.height: break
                for x, ch in enumerate(line.rstrip('\n\r')):
                    if x >= self.width: break
                    self.grid[y][x] = ch
            self.rom_name = os.path.basename(filename).replace('.rom', '')
            self._log("load_rom", {"rom": self.rom_name})
            return True
        except Exception as e:
            print(f"Error loading {filename}: {e}")
            return False
    
    def create_pointer(self, x=0, y=0, dx=1, dy=0, stack=None):
        pid = self.next_pid
        self.next_pid += 1
        self.pointers[pid] = {
            'x': x % self.width,
            'y': y % self.height,
            'dx': dx,
            'dy': dy,
            'stack': stack or [],
            'string_mode': False,
            'alive': True,
            'created': self.cycles
        }
        self._log("create_pointer", {"pid": pid})
        return pid
    
    def step(self, pid):
        if pid not in self.pointers:
            return False
        ptr = self.pointers[pid]
        if not ptr['alive']:
            return False
        
        x, y = ptr['x'], ptr['y']
        cell = self.grid[y][x]
        
        # Movement
        if cell == '>': ptr['dx'], ptr['dy'] = 1, 0
        elif cell == '<': ptr['dx'], ptr['dy'] = -1, 0
        elif cell == '^': ptr['dx'], ptr['dy'] = 0, -1
        elif cell == 'v': ptr['dx'], ptr['dy'] = 0, 1
        elif cell == '?': 
            dirs = [(1,0), (-1,0), (0,1), (0,-1)]
            ptr['dx'], ptr['dy'] = random.choice(dirs)
        # Stack operations
        elif cell == ':': 
            ptr['stack'].append(ptr['stack'][-1] if ptr['stack'] else 0)
        elif cell == '\\':
            if len(ptr['stack']) >= 2:
                a, b = ptr['stack'].pop(), ptr['stack'].pop()
                ptr['stack'].append(a); ptr['stack'].append(b)
        elif cell == '$' and ptr['stack']: 
            ptr['stack'].pop()
        # Arithmetic
        elif cell == '+' and len(ptr['stack']) >= 2:
            ptr['stack'].append(ptr['stack'].pop() + ptr['stack'].pop())
        elif cell == '-' and len(ptr['stack']) >= 2:
            a, b = ptr['stack'].pop(), ptr['stack'].pop()
            ptr['stack'].append(b - a)
        elif cell == '*' and len(ptr['stack']) >= 2:
            ptr['stack'].append(ptr['stack'].pop() * ptr['stack'].pop())
        elif cell == '/' and len(ptr['stack']) >= 2:
            a, b = ptr['stack'].pop(), ptr['stack'].pop()
            ptr['stack'].append(b // a if a != 0 else 0)
        # I/O
        elif cell == '.' and ptr['stack']:
            val = ptr['stack'].pop()
            print(val, end='', flush=True)
            self._log("output", {"value": val})
        elif cell == ',' and ptr['stack']:
            val = ptr['stack'].pop()
            print(chr(val % 256), end='', flush=True)
        # String mode
        elif cell == '"':
            ptr['string_mode'] = not ptr['string_mode']
        # Numbers
        elif cell in '0123456789' and not ptr['string_mode']:
            ptr['stack'].append(int(cell))
        elif ptr['string_mode']:
            ptr['stack'].append(ord(cell))
        # Death
        elif cell == '@':
            ptr['alive'] = False
            self._log("pointer_death", {"pid": pid})
            return False
        
        ptr['x'] = (ptr['x'] + ptr['dx']) % self.width
        ptr['y'] = (ptr['y'] + ptr['dy']) % self.height
        self.cycles += 1
        return True
    
    def run(self, max_cycles=None):
        while self.pointers and (max_cycles is None or self.cycles < max_cycles):
            for pid in list(self.pointers.keys()):
                if not self.step(pid):
                    del self.pointers[pid]
    
    def _log(self, event, data):
        self.telemetry.append({"event": event, "data": data, "cycle": self.cycles})
    
    def render(self):
        print('\n╔' + '═' * self.width + '╗')
        for y in range(self.height):
            line = ''.join(self.grid[y])
            print('║' + line + '║')
        print('╚' + '═' * self.width + '╝')
        print(f"{self.seal} {self.rom_name} | Cycles: {self.cycles} | Pointers: {len(self.pointers)}")

def main():
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument("command", nargs="?", default="run")
    parser.add_argument("--rom", help="ROM file to run")
    parser.add_argument("--max-cycles", type=int, default=50000)
    
    args = parser.parse_args()
    
    f = FungeOS()
    if args.rom:
        f.load_rom(args.rom)
        f.create_pointer()
        f.run(max_cycles=args.max_cycles)
        f.render()

if __name__ == "__main__":
    main()
EOF

