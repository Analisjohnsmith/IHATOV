#!/usr/bin/env python3
"""
Xenakis Evolution Engine — Breed better games
"""

import numpy as np
import random
import sys
import os

class XenakisGenome:
    def __init__(self, params=None):
        if params is None:
            self.params = [random.uniform(-1.5, 1.5) for _ in range(5)]
        else:
            self.params = params.copy()
        self.fitness = 0.0
    
    def mutate(self, rate=0.05):
        for i in range(len(self.params)):
            self.params[i] += random.gauss(0, rate)
        return self
    
    def to_grid(self, width=40, height=20):
        grid = [[' ' for _ in range(width)] for _ in range(height)]
        a,b,c,d,e = self.params
        for y in range(height):
            for x in range(width):
                val = (a*x + b*y + c*(x*y) + d*(x*x) + e*(y*y)) % 1.0
                if val < 0.1: grid[y][x] = '>'
                elif val < 0.2: grid[y][x] = '<'
                elif val < 0.3: grid[y][x] = '^'
                elif val < 0.4: grid[y][x] = 'v'
                elif val < 0.5: grid[y][x] = '+'
                elif val < 0.6: grid[y][x] = '-'
                elif val < 0.7: grid[y][x] = '*'
                elif val < 0.8: grid[y][x] = ':'
                elif val < 0.9: grid[y][x] = '.'
                else: grid[y][x] = '@'
        return grid

class XenakisPopulation:
    def __init__(self, size=20):
        self.organisms = [XenakisGenome() for _ in range(size)]
    
    def evaluate(self, fitness_fn):
        for org in self.organisms:
            org.fitness = fitness_fn(org)
        self.organisms.sort(key=lambda o: o.fitness, reverse=True)
    
    def evolve(self, keep=4):
        new_pop = self.organisms[:keep]
        while len(new_pop) < len(self.organisms):
            parent = random.choice(self.organisms[:keep*2])
            child = XenakisGenome(parent.params)
            child.mutate()
            new_pop.append(child)
        self.organisms = new_pop
    
    def best(self):
        return self.organisms[0]

def dummy_fitness(genome):
    return sum(genome.params) % 1.0

def main():
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument("--generations", type=int, default=20)
    parser.add_argument("--population", type=int, default=20)
    parser.add_argument("--output", default="evolved.rom")
    
    args = parser.parse_args()
    
    pop = XenakisPopulation(size=args.population)
    
    for gen in range(args.generations):
        pop.evaluate(dummy_fitness)
        pop.evolve()
        best = pop.best()
        print(f"Gen {gen:3d}: best fitness = {best.fitness:.4f}")
    
    grid = best.to_grid()
    with open(args.output, 'w') as f:
        for row in grid:
            f.write(''.join(row) + '\n')
    print(f"\n✅ Evolved ROM saved to: {args.output}")

if __name__ == "__main__":
    main()
