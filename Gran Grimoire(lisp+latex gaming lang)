#!/usr/bin/env python3
"""
FANTA Governance Engine — Policy, Audit, Temporal Branching
"""

import json
import hashlib
import time
import os

class FANTA:
    def __init__(self, audit_path=None):
        self.policies = []
        self.audit_path = audit_path or os.path.expanduser("~/ffx/audit/audit.log")
        self.branches = {}
    
    def add_policy(self, name, condition, action, priority=0):
        self.policies.append({
            "name": name,
            "condition": condition,
            "action": action,
            "priority": priority
        })
        self.policies.sort(key=lambda p: p["priority"], reverse=True)
    
    def enforce(self, action, context):
        for policy in self.policies:
            if self._match(policy["condition"], action, context):
                self._audit(policy["name"], action, context, policy["action"])
                return policy["action"]
        self._audit("default", action, context, "allow")
        return "allow"
    
    def _match(self, condition, action, context):
        if condition == "all": return True
        if condition.startswith("action="):
            return action == condition[7:]
        if "AND" in condition:
            parts = condition.split("AND")
            return all(self._match(p.strip(), action, context) for p in parts)
        return False
    
    def _audit(self, policy, action, context, decision):
        entry = {
            "timestamp": time.time(),
            "policy": policy,
            "action": action,
            "context": context,
            "decision": decision
        }
        with open(self.audit_path, 'a') as f:
            f.write(json.dumps(entry) + '\n')
    
    def branch(self, state, branch_id=None):
        if branch_id is None:
            branch_id = hashlib.sha256(str(time.time()).encode()).hexdigest()[:16]
        self.branches[branch_id] = {"state": state, "timestamp": time.time()}
        return branch_id
    
    def restore(self, branch_id):
        if branch_id in self.branches:
            return self.branches[branch_id]["state"]
        return None
    
    def heal_economy(self, resources):
        for k, v in resources.items():
            if v < 0 or v > 1000000:
                resources[k] = 1000
                self._audit("economy_heal", "correction", {k: v}, "heal")
        return resources

def main():
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=["policy-add", "audit", "branch"])
    parser.add_argument("--name", help="Policy name")
    parser.add_argument("--condition", help="Policy condition")
    parser.add_argument("--action", help="Policy action")
    
    args = parser.parse_args()
    f = FANTA()
    
    if args.command == "policy-add":
        f.add_policy(args.name, args.condition, args.action)
        print(f"Added policy: {args.name}")
    elif args.command == "audit":
        try:
            with open(f.audit_path, 'r') as fh:
                for line in fh:
                    print(line.strip())
        except:
            print("No audit entries yet")

if __name__ == "__main__":
    main()
