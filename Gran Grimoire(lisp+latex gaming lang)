"""
Sāra-Vēls Generative Engine — AꞨ₂₃₄₅₈₃₆₉₀₁
Every fractal is a program. Every program is a game.
"""

import numpy as np
import hashlib
import sys
import os

class SaraVelsAttractor:
    def __init__(self):
        self.sequence = [2, 3, 4, 5, 8, 3, 6, 9, 0, 1]
        self.phi = (1 + np.sqrt(5)) / 2
        self.theta = 2.345
        self._init_operators()
        self.trajectory = []
    
    def _init_operators(self):
        phi, theta = self.phi, self.theta
        
        def T2(X): c, s = np.cos(theta), np.sin(theta); return np.array([X[0]*c - X[1]*s, X[0]*s + X[1]*c, X[2], X[3]])
        def T3(X): return np.array([X[0], X[1], X[2] + X[3]*phi, X[3] + X[2]*phi])
        def T4(X): return X + np.array([0.5, 0.25, 0.309, 0.809])
        def T5(X): return np.array([-X[0], -X[1], X[2], X[3]])
        def T8(X): r = np.sqrt(X[0]**2 + X[1]**2); return np.array([X[0] + r*np.cos(X[3]), X[1] + r*np.sin(X[3]), X[2] + r, X[3] + theta])
        def T6(X): return X * phi
        def T9(X): return np.array([np.sin(X[0])*X[1]*phi, np.cos(X[1])*X[0]/phi, np.sin(X[2])*X[3], np.cos(X[3])*X[2]])
        def T0(X): return np.array([0.0, 0.0, 0.0, 0.0])
        def T1(X): n = np.sqrt(np.sum(X**2)) + 1e-10; return X / n
        
        self.operators = [T2, T3, T4, T5, T8, T3, T6, T9, T0, T1]
        self.operator_names = ["Dve", "Tri", "Chatur", "Pancha", "Aṣṭa", "Tri", "Ṣaṣ", "Nava", "Śūnya", "Eka"]
    
    def generate(self, cycles=5000):
        X = np.array([0.1, 0.1, 0.1, 0.1])
        trajectory = []
        for cycle in range(cycles):
            for op in self.operators:
                X = op(X)
                if np.all(np.abs(X) < 1000):
                    trajectory.append(X.copy())
        self.trajectory = trajectory
        return trajectory
    
    def point_to_instruction(self, point):
        x, y, z, w = point
        nx = (np.tanh(x) + 1) / 2
        nw = (np.tanh(w) + 1) / 2
        
        if nw < 0.1: return ['>', '<', '?', '^', 'v'][int(nx * 5)]
        elif nw < 0.3: return ['+', '-', '*', '/', '%'][int(nx * 5)]
        elif nw < 0.5: return [':', '\\', '$', '.', ','][int(nx * 5)]
        elif nw < 0.7: return ['>', '<', '^', 'v', '?'][int(nx * 5)]
        else: return '@'
    
    def generate_rom(self, width=80, height=25):
        if not self.trajectory:
            self.generate()
        grid = [[' ' for _ in range(width)] for _ in range(height)]
        for i, point in enumerate(self.trajectory[:width*height]):
            x = i % width
            y = i // width % height
            grid[y][x] = self.point_to_instruction(point)
        return grid
    
    def fractal_dimension(self, sample=3000):
        points = np.array([p[:3] for p in self.trajectory[:sample]])
        epsilons = np.logspace(-1.5, 0, 10)
        counts = []
        for eps in epsilons:
            boxes = set(tuple(np.floor(p/eps).astype(int)) for p in points)
            counts.append(len(boxes))
        log_eps = np.log(1/epsilons)
        log_counts = np.log(counts)
        coeffs = np.polyfit(log_eps, log_counts, 1)
        return coeffs[0]

