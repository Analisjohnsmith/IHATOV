class GestureInterpreter:
    def interpret(self, gesture: Gesture, intensity: float = 1.0) -> Dict:
        mapping = {Gesture.SWEEP: "explore", Gesture.BLOOM: "reveal", Gesture.GATHER: "collect",
                   Gesture.FOLD: "save", Gesture.LIFT: "select", Gesture.SPIRAL: "transform",
                   Gesture.TOUCH: "interact"}
        return {"type": mapping.get(gesture, "interact"), "strength": intensity, "gesture": gesture.value}

# ============================================================================
# DATABASE MANAGER
# ============================================================================

class DatabaseManager:
    def __init__(self, data_dir: str = "./aurira_data"):
        self.data_dir = Path(data_dir)
        self.data_dir.mkdir(parents=True, exist_ok=True)
        self.db_path = self.data_dir / "platform.db"
        self._init_db()
    
    def _init_db(self):
        with sqlite3.connect(self.db_path) as conn:
            conn.execute("CREATE TABLE IF NOT EXISTS users (user_id TEXT PRIMARY KEY, email TEXT UNIQUE, created_at REAL)")
            conn.execute("CREATE TABLE IF NOT EXISTS artifacts (id TEXT PRIMARY KEY, name TEXT, type TEXT, data TEXT, owner_id TEXT, created_at REAL)")
            conn.execute("CREATE TABLE IF NOT EXISTS levels (id TEXT PRIMARY KEY, name TEXT, data TEXT, owner_id TEXT, created_at REAL)")
            conn.execute("CREATE TABLE IF NOT EXISTS nodes (id TEXT PRIMARY KEY, name TEXT, data TEXT, owner_id TEXT, created_at REAL)")
    
    def save_user(self, user_id: str, email: str):
        with sqlite3.connect(self.db_path) as conn:
            conn.execute("INSERT OR REPLACE INTO users VALUES (?, ?, ?)", (user_id, email, time.time()))
    
    def save_artifact(self, artifact_id: str, name: str, type: str, data: Dict, owner_id: str):
        with sqlite3.connect(self.db_path) as conn:
            conn.execute("INSERT OR REPLACE INTO artifacts VALUES (?, ?, ?, ?, ?, ?)",
                        (artifact_id, name, type, json.dumps(data), owner_id, time.time()))

