        self.db.save_artifact(nano_id(), f"action_{action}", "action", result, "system")
        
        return result
    
    def process_gesture(self, gesture_name: str, intensity: float = 1.0) -> Dict:
        """Process a player gesture"""
        try:
            gesture = Gesture(gesture_name.lower())
        except ValueError:
            return {"error": f"Unknown gesture: {gesture_name}"}
        
        intention = self.gestures.interpret(gesture, intensity)
        return self.perform_action(intention["type"], {"strength": intention["strength"]})
    
    def perform_ritual(self, ritual_name: str) -> Dict:
        """Perform a ritual"""
        rituals = {
            "init": {"effect": "initialize_mythic_space", "energy": 0.8},
            "weave": {"effect": "connect_threads", "energy": 0.9},
            "preserve": {"effect": "seal_in_time", "energy": 0.7},
            "rebirth": {"effect": "renew_transform", "energy": 1.0},
            "triumph": {"effect": "celebrate_victory", "energy": 1.0},
            "gratitude": {"effect": "creative_completion", "energy": 0.5}
        }
        
        config = rituals.get(ritual_name.lower(), rituals["init"])
        
        # Evolve field
        for node_id in list(self.field.nodes.keys())[:5]:
            self.field.evolve_node(node_id, config["energy"] * 20)
        
        self.db.save_artifact(nano_id(), f"ritual_{ritual_name}", "ritual", config, "system")
        
        return {"ritual": ritual_name, "effect": config["effect"], "energy": config["energy"]}
    
    # ========================================================================
    # Universe Management
    # ========================================================================
    
    def create_node(self, name: str, archetype: str = "life", energy: float = 100) -> Dict:
        """Create a living node in the universe"""
        try:
            arch = NodeArchetype(archetype.lower())
        except ValueError:
            arch = NodeArchetype.LIFE
        
        node = LivingNode(name=name, archetype=arch, energy=energy)
        self.field.add_node(node)
        self.db.save_node(node.id, name, node.to_dict(), "system")
        
        return node.to_dict()
    
    def evolve_universe(self, cycles: int = 1) -> Dict:
        """Evolve the entire universe"""
        for _ in range(cycles):
            for node_id in list(self.field.nodes.keys()):
                delta = random.uniform(-1, 5)
                self.field.evolve_node(node_id, delta)
        
        return {"cycles": cycles, "universe": self.field.get_stats()}
    
    def get_universe_stats(self) -> Dict:
        """Get universe statistics"""
        return {
            "nodes": len(self.field.nodes),
            "total_consciousness": self.field.total_consciousness,
            "harmony": self.field.harmony,
            "resonance": self.resonance.current,
            "resonance_level": self.resonance.get_level().value
        }
    
    # ========================================================================
    # System Operations
    # ========================================================================
    
    def get_status(self) -> Dict:
        """Get complete system status"""
        return {
            "version": VERSION,
            "author": AUTHOR,
            "cores": {"loss": LOSS, "fragmentation": FRAGMENTATION, "coherence": COHERENCE, 
                      "sovereignty": SOVEREIGNTY, "drift": DRIFT},
            "seals": {"functions": len(FUNCTIONS), "domains": len(DOMAINS), "total": len(FUNCTIONS) * len(DOMAINS)},
            "universe": self.get_universe_stats(),
            "packages": len(self.list_packages())
        }
    
    def backup(self) -> str:
        """Create a backup"""
        backup_path = f"./aurira_data/backup_{int(time.time())}.db"
        import shutil
        shutil.copy2(self.db.db_path, backup_path)
        return backup_path
    
    def shutdown(self):
        """Graceful shutdown"""
        print("🛑 Shutting down GenStudio Package Manager...")
        self.backup()
        print("✨ All invariants preserved. Goodbye!")

