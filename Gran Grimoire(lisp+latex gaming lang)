@dataclass
class LivingNode:
    id: str = field(default_factory=nano_id)
    name: str = ""
    archetype: NodeArchetype = NodeArchetype.SEED
    energy: float = 100.0
    consciousness: float = 1.0
    coherence: float = 1.0
    dna: Dict = field(default_factory=dict)
    memories: List = field(default_factory=list)
    relationships: Dict = field(default_factory=dict)
    children: List = field(default_factory=list)
    parents: List = field(default_factory=list)
    domains: Set = field(default_factory=set)
    tags: Set = field(default_factory=set)
    created_at: str = field(default_factory=timestamp)
    
    def __post_init__(self):
        if not self.name:
            self.name = f"Node_{self.id[:8]}"
        if not self.domains:
            self.domains = {"universal"}
    
    def evolve(self, energy_delta: float = 0) -> Dict:
        self.energy = max(0, min(10000, self.energy + energy_delta))
        self.consciousness = min(100, self.consciousness + (energy_delta / 100))
        return {"node_id": self.id, "energy": self.energy, "consciousness": self.consciousness}
    
    def to_dict(self) -> Dict:
        return {"id": self.id, "name": self.name, "archetype": self.archetype.value,
                "energy": self.energy, "consciousness": self.consciousness,
                "domains": list(self.domains), "tags": list(self.tags)}

# ============================================================================
