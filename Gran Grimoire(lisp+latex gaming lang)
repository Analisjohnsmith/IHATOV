def timestamp() -> str:
    return datetime.utcnow().isoformat() + "Z"

def nano_id() -> str:
    return uuid.uuid4().hex[:16]

def deep_hash(obj: Any) -> str:
    return hashlib.sha512(json.dumps(obj, sort_keys=True, default=str).encode()).hexdigest()[:16]

