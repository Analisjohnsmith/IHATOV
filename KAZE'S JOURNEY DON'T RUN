class ResonanceLevel(Enum):
    DORMANT = "dormant"; STIRRING = "stirring"; AWAKENED = "awakened"
    RESONANT = "resonant"; HARMONIC = "harmonic"; PERFECT = "perfect"

class ResonanceEngine:
    def __init__(self):
        self.current = 0.5
        self.history = []
    
    def calculate(self, intention: Dict, world: Dict, player: Dict) -> float:
        self.current = (intention.get("strength", 0.5) * 0.4 + world.get("receptivity", 0.5) * 0.3 + player.get("flow", 0.5) * 0.3)
        self.current = max(0.0, min(1.0, self.current))
        self.history.append(self.current)
        return self.current
    
    def get_level(self) -> ResonanceLevel:
        if self.current < 0.2: return ResonanceLevel.DORMANT
        if self.current < 0.4: return ResonanceLevel.STIRRING
        if self.current < 0.6: return ResonanceLevel.AWAKENED
        if self.current < 0.8: return ResonanceLevel.RESONANT
        if self.current < 0.95: return ResonanceLevel.HARMONIC
        return ResonanceLevel.PERFECT
    
    def get_effects(self) -> Dict:
        effects = {ResonanceLevel.DORMANT: {"difficulty": 1.2, "loot": 0.5},
                   ResonanceLevel.STIRRING: {"difficulty": 1.1, "loot": 0.7},
                   ResonanceLevel.AWAKENED: {"difficulty": 1.0, "loot": 1.0},
                   ResonanceLevel.RESONANT: {"difficulty": 0.9, "loot": 1.3},
                   ResonanceLevel.HARMONIC: {"difficulty": 0.8, "loot": 1.7},
                   ResonanceLevel.PERFECT: {"difficulty": 0.6, "loot": 2.5}}
        return effects.get(self.get_level(), effects[ResonanceLevel.AWAKENED])

class Gesture(Enum):
    SWEEP = "sweep"; BLOOM = "bloom"; GATHER = "gather"
    FOLD = "fold"; LIFT = "lift"; SPIRAL = "spiral"; TOUCH = "touch"

class GestureInterpreter:
    def interpret(self, gesture: Gesture, intensity: float = 1.0) -> Dict:
        mapping = {Gesture.SWEEP: "explore", Gesture.BLOOM: "reveal", Gesture.GATHER: "collect",
                   Gesture.FOLD: "save", Gesture.LIFT: "select", Gesture.SPIRAL: "transform",
                   Gesture.TOUCH: "interact"}
        return {"type": mapping.get(gesture, "interact"), "strength": intensity, "gesture": gesture.value}

