@dataclass
class Artifact:
    """FANTA Artifact — Non-fungible token with unique properties"""
    id: str
    name: str
    type: ArtifactType
    rarity: ArtifactRarity
    owner: str
    created_at: str
    metadata: Dict[str, Any] = field(default_factory=dict)
    traits: List[str] = field(default_factory=list)
    power: float = 1.0
    soul_bound: bool = False
    transaction_history: List[Dict] = field(default_factory=list)
    
    @property
    def rarity_icon(self) -> str:
        return self.rarity.icon
    
    @property
    def display_name(self) -> str:
        return f"{self.rarity_icon} {self.name} ({self.rarity.display_name})"
    
    def get_power_score(self) -> float:
        """Calculate artifact power score based on rarity and traits"""
        base = self.power * self.rarity.multiplier
        trait_bonus = len(self.traits) * 0.1
        return base * (1 + trait_bonus)
    
    def to_nft_metadata(self) -> Dict:
        """Generate NFT-compatible metadata"""
        return {
            "name": self.name,
            "description": self.metadata.get("description", f"A {self.rarity.display_name} {self.type.value}"),
            "image": self.metadata.get("image", f"https://fanta.artifacts/{self.id}.png"),
            "attributes": [
                {"trait_type": "Rarity", "value": self.rarity.display_name},
                {"trait_type": "Type", "value": self.type.value},
                {"trait_type": "Power Score", "value": self.get_power_score()},
                {"trait_type": "Soul Bound", "value": self.soul_bound},
            ] + [{"trait_type": "Trait", "value": t} for t in self.traits],
            "properties": {
                "id": self.id,
                "created_at": self.created_at,
                "owner": self.owner,
                "transaction_history": self.transaction_history[-5:]  # Last 5 transactions
            }
        }
    
    def to_dict(self) -> Dict:
        return {
            "id": self.id, "name": self.name, "type": self.type.value,
            "rarity": self.rarity.value[0], "owner": self.owner,
            "created_at": self.created_at, "metadata": self.metadata,
            "traits": self.traits, "power": self.power,
            "soul_bound": self.soul_bound, "transaction_history": self.transaction_history
        }
    
    @classmethod
    def from_dict(cls, data: Dict) -> 'Artifact':
        rarity = next(r for r in ArtifactRarity if r.value[0] == data["rarity"])
        type_enum = ArtifactType(data["type"])
        return cls(
            id=data["id"], name=data["name"], type=type_enum, rarity=rarity,
            owner=data["owner"], created_at=data["created_at"], metadata=data.get("metadata", {}),
            traits=data.get("traits", []), power=data.get("power", 1.0),
            soul_bound=data.get("soul_bound", False), transaction_history=data.get("transaction_history", [])
        )

class FANTAEngine:
    """Fantasy Artifacts Non-fungible Token Architecture — Complete NFT Engine"""
    
    def __init__(self):
        self.artifacts: Dict[str, Artifact] = {}
        self.owners: Dict[str, List[str]] = defaultdict(list)  # owner_id -> list of artifact_ids
        self.marketplace: Dict[str, Dict] = {}  # artifact_id -> listing
        self.mint_counter = 0
        self.total_minted = 0
        self.total_burned = 0
    
    def mint_artifact(self, name: str, type_str: str, rarity_str: str, owner: str, 
                      traits: List[str] = None, power: float = None, 
                      soul_bound: bool = False, metadata: Dict = None) -> Artifact:
        """Mint a new artifact (create NFT)"""
        self.mint_counter += 1
        artifact_id = f"ART_{self.mint_counter:04d}_{nano_id()[:8]}"
        
        # Determine type
        try:
            artifact_type = ArtifactType(type_str.lower())
        except ValueError:
            artifact_type = ArtifactType.MATERIAL
        
        # Determine rarity
        try:
            rarity = next(r for r in ArtifactRarity if r.value[0] == rarity_str.lower())
        except StopIteration:
            rarity = ArtifactRarity.COMMON
        
        # Generate power if not provided
        if power is None:
            power = random.uniform(0.5, 2.0) * rarity.multiplier
        
        # Generate traits if not provided
        if traits is None:
            trait_pool = ["ancient", "cursed", "blessed", "enchanting", "sharp", "sturdy", "light", "heavy", "magical"]
            num_traits = random.randint(0, min(3, rarity.tier))
            traits = random.sample(trait_pool, num_traits) if num_traits > 0 else []
        
        artifact = Artifact(
            id=artifact_id,
            name=name,
            type=artifact_type,
            rarity=rarity,
            owner=owner,
            created_at=timestamp(),
            metadata=metadata or {},
            traits=traits,
            power=power,
            soul_bound=soul_bound,
            transaction_history=[{
                "event": "mint",
                "from": "system",
                "to": owner,
                "timestamp": timestamp()
            }]
        )
        
        self.artifacts[artifact_id] = artifact
        self.owners[owner].append(artifact_id)
        self.total_minted += 1
        
        print(f"✨ Minted: {artifact.display_name} for {owner}")
        return artifact
    
    def transfer_artifact(self, artifact_id: str, from_owner: str, to_owner: str) -> bool:
        """Transfer artifact ownership"""
        artifact = self.artifacts.get(artifact_id)
        if not artifact:
            print(f"❌ Artifact {artifact_id} not found")
            return False
        
        if artifact.soul_bound and from_owner != "system":
            print(f"❌ Cannot transfer soul-bound artifact {artifact.name}")
            return False
        
        if artifact.owner != from_owner:
            print(f"❌ {from_owner} does not own {artifact.name}")
            return False
        
        # Remove from old owner
        if artifact_id in self.owners[from_owner]:
            self.owners[from_owner].remove(artifact_id)
        
        # Add to new owner
        artifact.owner = to_owner
        self.owners[to_owner].append(artifact_id)
        artifact.transaction_history.append({
            "event": "transfer",
            "from": from_owner,
            "to": to_owner,
            "timestamp": timestamp()
        })
        
        print(f"🔄 Transferred: {artifact.display_name} from {from_owner} to {to_owner}")
        return True
    
    def burn_artifact(self, artifact_id: str, owner: str, reason: str = "destroyed") -> bool:
        """Burn (destroy) an artifact"""
        artifact = self.artifacts.get(artifact_id)
        if not artifact:
            return False
        
        if artifact.owner != owner:
            return False
        
        self.owners[owner].remove(artifact_id)
        del self.artifacts[artifact_id]
        self.total_burned += 1
        
        print(f"🔥 Burned: {artifact.display_name} ({reason})")
        return True
    
    def list_for_sale(self, artifact_id: str, owner: str, price: float, currency: str = "gold") -> bool:
        """List artifact on marketplace"""
        artifact = self.artifacts.get(artifact_id)
        if not artifact or artifact.owner != owner:
            return False
        
        if artifact.soul_bound:
            return False
        
        self.marketplace[artifact_id] = {
            "artifact_id": artifact_id,
            "seller": owner,
            "price": price,
            "currency": currency,
            "listed_at": timestamp()
        }
        
        print(f"📦 Listed: {artifact.display_name} for {price} {currency}")
        return True
    
    def buy_artifact(self, artifact_id: str, buyer: str) -> Tuple[bool, Optional[Artifact]]:
        """Purchase artifact from marketplace"""
        listing = self.marketplace.get(artifact_id)
        if not listing:
            return False, None
        
        if self.transfer_artifact(artifact_id, listing["seller"], buyer):
            del self.marketplace[artifact_id]
            return True, self.artifacts.get(artifact_id)
        
        return False, None
    
    def get_owner_artifacts(self, owner: str) -> List[Artifact]:
        """Get all artifacts owned by a user"""
        return [self.artifacts[a_id] for a_id in self.owners.get(owner, []) if a_id in self.artifacts]
    
    def generate_random_artifact(self, owner: str, tier_hint: str = None) -> Artifact:
