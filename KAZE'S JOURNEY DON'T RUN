    def __init__(self):
        self.nodes: Dict[str, LivingNode] = {}
        self.total_consciousness = 0.0
        self.harmony = 1.0
    
    def add_node(self, node: LivingNode) -> str:
        self.nodes[node.id] = node
        self.total_consciousness += node.consciousness
        return node.id
    
    def evolve_node(self, node_id: str, delta: float) -> Dict:
        if node_id in self.nodes:
            return self.nodes[node_id].evolve(delta)
        return {"error": "Node not found"}
    
    def add_artifact_to_node(self, node_id: str, artifact_id: str):
        if node_id in self.nodes:
            self.nodes[node_id].artifacts.append(artifact_id)
    
    def get_stats(self) -> Dict:
        return {"nodes": len(self.nodes), "consciousness": self.total_consciousness, "harmony": self.harmony}

