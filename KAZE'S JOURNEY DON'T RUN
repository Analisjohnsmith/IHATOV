class FractalTree:
    def __init__(self, name: str = "root"):
        self.name = name
        self.root = FractalNode("/", tags=["root", "system"])
        self.current = self.root
        self.nodes: Dict[str, FractalNode] = {self.root.uid: self.root}
        self.history: List[Dict] = []
        self.history_index = -1
        self._init_base_structure()
    
    def _init_base_structure(self):
        self.mkdir("system", ["system", "core"])
        self.mkdir("user", ["user", "home"])
        self.mkdir("media", ["media", "output"])
        self.mkdir("substrate", ["math", "sigma_gen"])
        self.mkdir("kenji", ["kenji", "the_choice_at_the_core"])
        self.mkdir("ihatov", ["ihatov", "field", "ecology"])
        self.mkdir("kaze", ["kaze", "wind", "journey"])
        self.mkdir("consciousness", ["consciousness", "field", "nodes"])
        self.mkdir("fanta", ["fanta", "artifacts", "nft"])  # FANTA directory
    
    def mkdir(self, name: str, tags: List[str] = None) -> FractalNode:
        node = FractalNode(name, tags or [], self.current)
        self.current.kids.append(node)
        self.nodes[node.uid] = node
        return node
    
    def cd(self, path: str):
        if path == "/":
            self.current = self.root
        elif path == "..":
            if self.current.parent:
                self.current = self.current.parent
        else:
            for node in self.current.kids:
                if node.value == path:
                    self.current = node
                    return
    
    def ls(self) -> List[FractalNode]:
        return self.current.kids.copy()
    
    def tree(self, node: FractalNode = None, depth: int = 0, max_depth: int = 10) -> str:
        if depth > max_depth:
            return "  " * depth + "...\n"
        node = node or self.root
        tag_str = f"[{','.join(node.tags[:3])}]" if node.tags else ""
        out = "  " * depth + f"📁 {node.value} {tag_str}\n"
        for k in node.kids:
            out += self.tree(k, depth + 1, max_depth)
        return out

