class FractalNode:
    __slots__ = ('value', 'tags', 'parent', 'kids', 'style', 'hash', 'uid', 'created', 'modified', 'version', 'media_cache')
    
    def __init__(self, value: Any, tags: List[str] = None, parent=None):
        self.value = value
        self.tags = tags or []
        self.parent = parent
        self.kids = []
        self.style = {}
        self.hash = hashlib.sha256(str(value).encode()).hexdigest()[:16]
        self.uid = f"{self.hash}_{int(time.time()*1000)}"
        self.created = time.time()
        self.modified = self.created
        self.version = 1
        self.media_cache = {}
    
    def __repr__(self): 
        tag_str = ','.join(self.tags[:3])
        return f"📦 {self.value} [{tag_str}] {self.hash[:6]}"
    
    def add_tag(self, tag: str):
        if tag not in self.tags:
            self.tags.append(tag)
            self.modified = time.time()
            self.version += 1
    
    def has_tag(self, tag: str) -> bool: return tag in self.tags
    
    def set_style(self, key: str, value: Any):
        self.style[key] = value
        self.modified = time.time()
    
    def get_style(self, key: str, default=None): return self.style.get(key, default)
    
    def get_path(self) -> str:
        if self.parent is None or self.parent.value == "/": return f"/{self.value}"
        return f"{self.parent.get_path()}/{self.value}"

