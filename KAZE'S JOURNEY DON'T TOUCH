class Terminal:
    COLORS = {
        "reset": "\033[0m", "bold": "\033[1m", "dim": "\033[2m",
        "red": "\033[31m", "green": "\033[32m", "yellow": "\033[33m",
        "blue": "\033[34m", "magenta": "\033[35m", "cyan": "\033[36m",
        "white": "\033[37m", "gray": "\033[90m", "orange": "\033[38;5;214m",
        "pink": "\033[38;5;205m", "brown": "\033[38;5;94m", "purple": "\033[38;5;141m",
        "gold": "\033[38;5;220m", "silver": "\033[38;5;250m",
    }
    
    @staticmethod
    def color(text: str, color: str) -> str:
        return f"{Terminal.COLORS.get(color, '')}{text}{Terminal.COLORS['reset']}"
    
    @staticmethod
    def clear():
        os.system('cls' if os.name == 'nt' else 'clear')
    
    @staticmethod
    def progress_bar(current: int, maximum: int, width: int = 20, color: str = "green") -> str:
        percent = current / maximum if maximum > 0 else 0
        filled = int(width * percent)
        bar = "█" * filled + "░" * (width - filled)
        return Terminal.color(bar, color)
    
    @staticmethod
    def heart(level: int, max_level: int = 10) -> str:
        filled = int((level / max_level) * 10)
        return "❤️" * filled + "🖤" * (10 - filled)
    
    @staticmethod
    def box(text: str, width: int = 70, color: str = "white") -> str:
        lines = text.split('\n')
        top = "╔" + "═" * (width - 2) + "╗"
        bottom = "╚" + "═" * (width - 2) + "╝"
        result = [Terminal.color(top, color)]
        for line in lines:
            wrapped = [line[i:i+width-4] for i in range(0, len(line), width-4)]
            for w in wrapped:
                result.append(Terminal.color(f"║ {w:<{width-4}} ║", color))
        result.append(Terminal.color(bottom, color))
        return '\n'.join(result)

