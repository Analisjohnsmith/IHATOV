class AttentionPool:
    def __init__(self, initial=100):
        self.pool = initial
        self.region_weights = {"field_dusk": 0.5, "path_a": 0.3, "path_b": 0.2}
        self.scores = {k: v * initial for k, v in self.region_weights.items()}
    
    def spend(self, region: str, amount: int) -> int:
        if amount <= 0: return 0
        spent = min(self.pool, amount)
        self.pool -= spent
        self.scores[region] = self.scores.get(region, 0) + spent
        return spent
    
    def tick_decay(self):
        for r in self.scores:
            self.scores[r] *= 0.995

class WorldSim:
    def __init__(self):
        self.attention = AttentionPool(100)
        self.beauty = {"field_dusk": 1.0, "path_a": 1.0, "path_b": 1.0}
        self.time = 0
    
    def tick(self):
        self.time += 1
        self.attention.tick_decay()
        for r in self.beauty:
            self.beauty[r] = max(0.0, self.beauty[r] - 0.002)
        return self.snapshot()
    
    def apply_attention(self, region: str, tokens: int = 5):
        spent = self.attention.spend(region, tokens)
        self.beauty[region] = min(2.0, self.beauty[region] + spent * 0.01)
        return spent
    
    def snapshot(self):
        return {"time": self.time, "attention_pool": self.attention.pool,
                "attention_scores": self.attention.scores, "beauty": self.beauty}

class ChoiceGame:
    def __init__(self):
        self.world = WorldSim()
        self.kenji = KenjiAgent()
    
    def tick(self, action: str):
        if action in self.world.attention.scores:
            self.world.apply_attention(action, 8)
        self.world.tick()
        self.kenji.evaluate(self.world.attention.scores.get("path_a", 0),
                           self.world.attention.scores.get("path_b", 0))
        return {"kenji_state": self.kenji.state, "kenji_mood": self.kenji.mood,
                "kenji_choice": self.kenji.choice, "attention": self.world.attention.scores,
                "beauty": self.world.beauty, "time": self.world.time}

