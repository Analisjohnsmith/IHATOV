    def get_stats(self) -> Dict:
        """Get FANTA engine statistics"""
        return {
            "total_minted": self.total_minted,
            "total_burned": self.total_burned,
            "active_artifacts": len(self.artifacts),
            "marketplace_listings": len(self.marketplace),
            "unique_owners": len([o for o in self.owners if self.owners[o]]),
            "rarity_distribution": {
                r.display_name: sum(1 for a in self.artifacts.values() if a.rarity == r)
                for r in ArtifactRarity
            }
        }
    
    def to_json(self) -> str:
        """Export all artifacts to JSON"""
        return json.dumps({
            "version": VERSION,
            "artifacts": [a.to_dict() for a in self.artifacts.values()],
            "marketplace": self.marketplace,
            "stats": self.get_stats()
        }, indent=2)
    
    def from_json(self, data: str):
        """Import artifacts from JSON"""
        obj = json.loads(data)
        for artifact_data in obj.get("artifacts", []):
            artifact = Artifact.from_dict(artifact_data)
            self.artifacts[artifact.id] = artifact
            self.owners[artifact.owner].append(artifact.id)
            self.total_minted += 1
