import struct
from datetime import datetime, timedelta

class MacUtils:
    """System utilities from Mac OS 1.0"""
    
    # Mac epoch: January 1, 1904
    MAC_EPOCH = datetime(1904, 1, 1)
    
    @staticmethod
    def date_to_mac_time(dt):
        """Convert datetime to Mac OS 32-bit seconds since 1904"""
        delta = dt - MacUtils.MAC_EPOCH
        return int(delta.total_seconds())
    
    @staticmethod
    def mac_time_to_date(mac_time):
        """Convert Mac OS seconds to datetime"""
        return MacUtils.MAC_EPOCH + timedelta(seconds=mac_time)
    
    @staticmethod
    def pascal_string_to_python(p_string):
        """Convert Pascal string (length byte + chars) to Python string"""
        if not p_string:
            return ""
        length = p_string[0]
        return p_string[1:1+length].decode('mac-roman', errors='replace')
    
    @staticmethod
    def python_to_pascal_string(s):
        """Convert Python string to Pascal string"""
        encoded = s.encode('mac-roman')[:255]  # Max 255 chars
        return bytes([len(encoded)]) + encoded
    
    @staticmethod
    def four_char_code(code):
        """Convert string to OSType (4-char code)"""
        if isinstance(code, str):
            return code.ljust(4)[:4].encode('ascii')
        return code.decode('ascii').strip()

