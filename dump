class QuickDraw:
    """
    Complete QuickDraw implementation
    Supports both 512x342 (original Mac) and custom sizes
    """
    
    # QuickDraw GrafPort modes
    MODES = {
        'srcCopy': 0,      # Source copy
        'srcOr': 1,        # Source OR
        'srcXor': 2,       # Source XOR  
        'srcBic': 3,       # Source BIC
        'notSrcCopy': 4,   # NOT source copy
        'notSrcOr': 5,     # NOT source OR
        'notSrcXor': 6,    # NOT source XOR
        'notSrcBic': 7,    # NOT source BIC
        'patCopy': 8,      # Pattern copy
        'patOr': 9,        # Pattern OR
        'patXor': 10,      # Pattern XOR
        'patBic': 11,      # Pattern BIC
        'notPatCopy': 12,  # NOT pattern copy
        'notPatOr': 13,    # NOT pattern OR
        'notPatXor': 14,   # NOT pattern XOR
        'notPatBic': 15,   # NOT pattern BIC
    }
    
    # Standard Mac patterns
    PATTERNS = {
        'black': [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF],
        'white': [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'gray':  [0xAA, 0x55, 0xAA, 0x55, 0xAA, 0x55, 0xAA, 0x55],
        'ltGray': [0xCC, 0x33, 0xCC, 0x33, 0xCC, 0x33, 0xCC, 0x33],
        'dkGray': [0x88, 0x22, 0x88, 0x22, 0x88, 0x22, 0x88, 0x22],
    }
    
    def __init__(self, width=512, height=342):
        """Initialize QuickDraw with given dimensions"""
        self.width = width
        self.height = height
        
        # The drawing canvas (1-bit black/white)
        self.canvas = bytearray((width * height) // 8)
        
        # Current graphics port (GrafPort)
        self.port = {
            'pen': {
                'location': (0, 0),
                'size': (1, 1),
                'mode': 'patCopy',
                'pattern': self.PATTERNS['black'],
            },
            'fore_color': 0,  # 0 = black, 1 = white
            'back_color': 1,
            'text': {
                'font': 'Chicago',
                'size': 12,
                'face': 0,  # 0=plain, 1=bold, 2=italic, 4=underline
                'mode': 'srcOr',
            },
            'origin': (0, 0),
            'clip_rect': (0, 0, width, height),
            'visible': True,
        }
        
        # For display
        self.root = None
        self.canvas_widget = None
        self.need_update = True
        
    # ========== COORDINATE FUNCTIONS ==========
    
    def MoveTo(self, h, v):
        """Move pen to absolute coordinates"""
        self.port['pen']['location'] = (h, v)
        
    def Move(self, dh, dv):
        """Move pen relative to current position"""
        h, v = self.port['pen']['location']
        self.port['pen']['location'] = (h + dh, v + dv)
        
    def GetPen(self):
        """Get current pen location"""
        return self.port['pen']['location']
    
    def SetOrigin(self, h, v):
        """Set global origin offset"""
        self.port['origin'] = (h, v)
        
    def SetClip(self, rect):
        """Set clipping rectangle (left, top, right, bottom)"""
        self.port['clip_rect'] = rect
        
    # ========== PEN FUNCTIONS ==========
    
    def PenSize(self, width, height):
        """Set pen size"""
        self.port['pen']['size'] = (width, height)
        
    def PenMode(self, mode):
        """Set pen drawing mode"""
        if mode in self.MODES:
            self.port['pen']['mode'] = mode
            
    def PenPat(self, pattern):
        """Set pen pattern (8 bytes defining 8x8 pattern)"""
        if len(pattern) == 8:
            self.port['pen']['pattern'] = list(pattern)
            
    def PenNormal(self):
        """Reset pen to default state"""
        self.port['pen']['size'] = (1, 1)
        self.port['pen']['mode'] = 'patCopy'
        self.port['pen']['pattern'] = self.PATTERNS['black']
        
    # ========== DRAWING FUNCTIONS ==========
    
    def PaintRect(self, rect):
        """Paint a rectangle with current pen pattern"""
        left, top, right, bottom = rect
        self._draw_rect(left, top, right, bottom, fill=True)
        
    def FrameRect(self, rect):
        """Draw outline of rectangle"""
        left, top, right, bottom = rect
        pen_w, pen_h = self.port['pen']['size']
        
        # Top line
        self._draw_line(left, top, right, top, pen_h)
        # Bottom line
        self._draw_line(left, bottom - pen_h, right, bottom - pen_h, pen_h)
        # Left line
        self._draw_line(left, top, left, bottom, pen_w)
        # Right line
        self._draw_line(right - pen_w, top, right - pen_w, bottom, pen_w)
        
    def PaintOval(self, rect):
        """Paint an oval inside rectangle"""
        left, top, right, bottom = rect
        self._draw_oval(left, top, right, bottom, fill=True)
        
    def FrameOval(self, rect):
        """Draw outline of oval"""
        left, top, right, bottom = rect
        self._draw_oval(left, top, right, bottom, fill=False)
        
    def PaintRoundRect(self, rect, oval_width, oval_height):
        """Paint rounded rectangle"""
        left, top, right, bottom = rect
        self._draw_round_rect(left, top, right, bottom, 
                             oval_width, oval_height, fill=True)
        
    def FrameRoundRect(self, rect, oval_width, oval_height):
        """Draw outline of rounded rectangle"""
        left, top, right, bottom = rect
        self._draw_round_rect(left, top, right, bottom, 
                             oval_width, oval_height, fill=False)
        
    def PaintArc(self, rect, start_angle, arc_angle):
        """Paint a wedge (pie slice)"""
        left, top, right, bottom = rect
        self._draw_arc(left, top, right, bottom, 
                      start_angle, arc_angle, fill=True)
        
    def FrameArc(self, rect, start_angle, arc_angle):
        """Draw outline of arc"""
        left, top, right, bottom = rect
        self._draw_arc(left, top, right, bottom, 
                      start_angle, arc_angle, fill=False)
        
    def PaintPolygon(self, points):
        """Paint a polygon"""
        self._draw_polygon(points, fill=True)
        
    def FramePolygon(self, points):
        """Draw outline of polygon"""
        self._draw_polygon(points, fill=False)
        
    def LineTo(self, h, v):
        """Draw line from current pen to specified point"""
        start_h, start_v = self.port['pen']['location']
        self._draw_line(start_h, start_v, h, v)
        self.port['pen']['location'] = (h, v)
        
    def Line(self, dh, dv):
        """Draw line relative from current pen"""
        start_h, start_v = self.port['pen']['location']
        end_h, end_v = start_h + dh, start_v + dv
        self._draw_line(start_h, start_v, end_h, end_v)
        self.port['pen']['location'] = (end_h, end_v)
        
    # ========== TEXT FUNCTIONS ==========
    
    def TextFont(self, font_num):
        """Set text font by ID (0-3 = system fonts)"""
        fonts = ['Chicago', 'Geneva', 'Monaco', 'New York']
        if 0 <= font_num < len(fonts):
            self.port['text']['font'] = fonts[font_num]
            
    def TextSize(self, size):
