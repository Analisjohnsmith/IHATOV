class CompleteDimensionalSystem:
    """Full integration of all systems applied to VALARI"""
    
    def __init__(self):
        self.valari = ValariDimensionalCodex()
        self.orb = DimensionalOrbCodex()
        self.activation_time = None
        self.system_hash = None
        
    def initialize(self, observer: str = "VALARI_PRIME") -> Dict:
        """Initialize complete dimensional system"""
        self.activation_time = time.time()
        
        # Activate VALARI
        self.valari.activate(observer)
        
        # Apply Orb
        self.valari = self.orb.apply_to_dissertation(self.valari)
        
        # Bind initial observer
        self.valari.bind_observer(observer)
        
        # Compute system hash
        self.system_hash = hashlib.sha256(
            f"{self.valari.dimensional_hash}{self.activation_time}".encode()
        ).hexdigest()
        
        # Enter first gate
        self.valari.enter_gate(1)  # Begin at Dimensional Wound
        
        # Apply first seal
        self.valari.apply_seal(1, "DIMENSIONAL_ROOT")
        
        return {
            "system": "VALARI Dimensional Dissertation",
            "status": "initialized",
            "activation_time": self.activation_time,
            "system_hash": self.system_hash,
            "valari_status": self.valari.get_status()
        }
    
    def run_complete_cycle(self) -> Dict:
        """Run a complete dimensional cycle through all gates"""
        results = []
        
        # Cycle through all 10 gates
        for gate in range(1, 11):
            gate_result = self.valari.enter_gate(gate)
            results.append(gate_result)
            
            # Apply corresponding seal
            seal_num = gate + 10  # Gates are seals 11-20
            seal_result = self.valari.apply_seal(seal_num, f"GATE_{gate}_CYCLE")
            results.append(seal_result)
        
        # Apply final seals
        for seal in [71, 72, 73, 81]:
            seal_result = self.valari.apply_seal(seal, "COMPLETION_CYCLE")
            results.append(seal_result)
        
        # Complete dissertation
        final = self.valari.complete_dissertation()
        results.append(final)
        
        return {
            "cycle_complete": True,
            "gates_traversed": 10,
            "seals_applied": len(results),
            "final_status": final,
            "results": results[-5:]  # Last 5 results
        }
    
    def witness_all_dimensions(self, witnesses: List[str]) -> Dict:
        """Bind multiple witnesses to validate dimensions"""
        witness_results = []
        
        for witness in witnesses:
            result = self.valari.bind_observer(witness)
            witness_results.append(result)
        
        return {
            "witnesses_bound": len(witnesses),
            "total_observers": self.valari.observers_count,
            "state": self.valari.current_state.value,
            "results": witness_results
        }
    
    def get_complete_status(self) -> Dict:
        """Get complete system status"""
        valari_status = self.valari.get_status()
        
        return {
            "system": "VALARI Dimensional Dissertation",
            "activation_time": self.activation_time,
            "uptime": time.time() - self.activation_time if self.activation_time else 0,
            "system_hash": self.system_hash,
            "valari": valari_status,
            "orb": {
                "name": self.orb.orb["name"],
                "unifying_seal": self.orb.orb["unifying_seal"],
                "three_trees": list(self.orb.orb["three_trees_dimensions"].keys())
            },
            "completion": valari_status["dissertation"]["final_seal"]["status"] == "eternal"
        }
    
    def to_json(self) -> str:
        """Export complete system as JSON"""
        return json.dumps({
            "system": "VALARI Dimensional Dissertation",
            "activation_time": self.activation_time,
            "system_hash": self.system_hash,
            "valari": json.loads(self.valari.to_json()),
            "orb": self.orb.orb,
            "complete_status": self.get_complete_status()
        }, indent=2)


