import { create } from 'zustand';
import { persist, createJSONStorage } from 'zustand/middleware';
import AsyncStorage from '@react-native-async-storage/async-storage';
export interface Scroll { id: number; date: string; layer: string; source: string; author: string; quote: string; command: string; rep: string; }
interface ScrollState { scrolls: Scroll[]; progress: { completedIds: number[]; notes: Record<number,string> }; loadScrolls: () => Promise<void>; getToday: () => Scroll | null; complete: (id: number, note?: string) => void; isCompleted: (id: number) => boolean; getStats: () => { completed: number; total: number; percentage: number }; }
export const useScrollStore = create<ScrollState>()(persist((set,get) => ({ scrolls: [], progress: { completedIds: [], notes: {} }, loadScrolls: async () => { try { const data = await import('../data/scrolls.json'); set({ scrolls: data.scrolls }); } catch(e) {} }, getToday: () => { const today = new Date().toISOString().split('T')[0]; return get().scrolls.find(s => s.date === today) || null; }, complete: (id,note) => { const { progress } = get(); if (!progress.completedIds.includes(id)) { const newNotes = { ...progress.notes }; if (note) newNotes[id] = note; set({ progress: { completedIds: [...progress.completedIds, id], notes: newNotes } }); } }, isCompleted: (id) => get().progress.completedIds.includes(id), getStats: () => { const { scrolls, progress } = get(); return { completed: progress.completedIds.length, total: scrolls.length, percentage: scrolls.length ? (progress.completedIds.length / scrolls.length) * 100 : 0 }; } }), { name: 'legacy-scroll-storage', storage: createJSONStorage(() => AsyncStorage), partialize: (state) => ({ progress: state.progress }) }));
