    def DrawChar(self, char):
        """Draw a single character at pen location"""
        h, v = self.port['pen']['location']
        self._draw_text(char, h, v)
        # Advance pen (monospaced for simplicity)
        self.Move(self.port['text']['size'] // 2, 0)
        
    def DrawString(self, text):
        """Draw a Pascal string at pen location"""
        if isinstance(text, bytes):
            # Pascal string
            length = text[0]
            text = text[1:1+length].decode('mac-roman')
        self._draw_text(text, *self.port['pen']['location'])
        # Advance pen
        self.Move(len(text) * self.port['text']['size'] // 2, 0)
        
    def DrawText(self, text, count):
        """Draw first 'count' characters of text"""
        self.DrawString(text[:count])
        
