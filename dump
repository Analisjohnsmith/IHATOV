    # ========== PRIVATE DRAWING METHODS ==========
    
    def _set_pixel(self, x, y, color):
        """Set pixel at (x,y) to color (0=black, 1=white)"""
        if x < 0 or x >= self.width or y < 0 or y >= self.height:
            return
        # Check clip rect
        l,t,r,b = self.port['clip_rect']
        if x < l or x >= r or y < t or y >= b:
            return
            
        # Convert to byte index and bit
        byte_idx = (y * self.width + x) // 8
        bit_idx = 7 - ((y * self.width + x) % 8)
        
        if color == 0:  # black
            self.canvas[byte_idx] |= (1 << bit_idx)
        else:  # white
            self.canvas[byte_idx] &= ~(1 << bit_idx)
            
    def _get_pixel(self, x, y):
        """Get pixel color at (x,y)"""
        if x < 0 or x >= self.width or y < 0 or y >= self.height:
            return 1  # white
        byte_idx = (y * self.width + x) // 8
        bit_idx = 7 - ((y * self.width + x) % 8)
        return (self.canvas[byte_idx] >> bit_idx) & 1
        
    def _draw_line(self, x1, y1, x2, y2, thickness=1):
        """Bresenham line algorithm"""
        dx = abs(x2 - x1)
        dy = abs(y2 - y1)
        sx = 1 if x1 < x2 else -1
        sy = 1 if y1 < y2 else -1
        err = dx - dy
        
        while True:
            # Draw thickness
            for tx in range(thickness):
                for ty in range(thickness):
                    self._set_pixel(x1 + tx, y1 + ty, self.port['fore_color'])
                    
            if x1 == x2 and y1 == y2:
                break
                
            e2 = 2 * err
            if e2 > -dy:
                err -= dy
                x1 += sx
            if e2 < dx:
                err += dx
                y1 += sy
                
    def _draw_rect(self, left, top, right, bottom, fill=True):
        """Draw or fill rectangle"""
        for y in range(top, bottom):
            for x in range(left, right):
                if fill:
                    self._set_pixel(x, y, self.port['fore_color'])
                else:
                    # Just outline
                    if (x == left or x == right-1 or 
                        y == top or y == bottom-1):
                        self._set_pixel(x, y, self.port['fore_color'])
                        
    def _draw_oval(self, left, top, right, bottom, fill=True):
        """Draw or fill oval"""
        # Center and radii
        cx = (left + right) / 2
        cy = (top + bottom) / 2
        rx = (right - left) / 2
        ry = (bottom - top) / 2
        
        for y in range(top, bottom):
            for x in range(left, right):
                # Ellipse equation
                if ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2 <= 1:
                    if fill:
                        self._set_pixel(x, y, self.port['fore_color'])
                    else:
                        # Only draw border (check if on edge)
                        dist = ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2
                        if 0.9 <= dist <= 1.1:
                            self._set_pixel(x, y, self.port['fore_color'])
                            
    def _draw_round_rect(self, left, top, right, bottom, 
                        oval_w, oval_h, fill=True):
        """Draw or fill rounded rectangle"""
        radius = min(oval_w, oval_h) // 2
        
        for y in range(top, bottom):
            for x in range(left, right):
                # Check if in corners
                if x < left + radius and y < top + radius:
                    # Top-left corner
                    if ((x - (left + radius)) ** 2 + 
                        (y - (top + radius)) ** 2 <= radius ** 2):
                        if fill:
                            self._set_pixel(x, y, self.port['fore_color'])
                elif x > right - radius and y < top + radius:
                    # Top-right corner
                    if ((x - (right - radius)) ** 2 + 
                        (y - (top + radius)) ** 2 <= radius ** 2):
                        if fill:
                            self._set_pixel(x, y, self.port['fore_color'])
                elif x < left + radius and y > bottom - radius:
                    # Bottom-left corner
                    if ((x - (left + radius)) ** 2 + 
                        (y - (bottom - radius)) ** 2 <= radius ** 2):
                        if fill:
                            self._set_pixel(x, y, self.port['fore_color'])
                elif x > right - radius and y > bottom - radius:
                    # Bottom-right corner
                    if ((x - (right - radius)) ** 2 + 
                        (y - (bottom - radius)) ** 2 <= radius ** 2):
                        if fill:
                            self._set_pixel(x, y, self.port['fore_color'])
                else:
                    # Main rectangle
                    if fill:
                        self._set_pixel(x, y, self.port['fore_color'])
                    elif (x == left or x == right-1 or 
                          y == top or y == bottom-1):
                        self._set_pixel(x, y, self.port['fore_color'])
                        
    def _draw_text(self, text, x, y):
        """Draw text using built-in font simulation"""
        # Simple monospaced rendering
        for i, char in enumerate(str(text)):
            # Draw character as 5x7 dot matrix (simple)
            if char == 'A':
                pattern = [0x3E, 0x51, 0x49, 0x45, 0x3E]  # Simple A
            elif char == 'B':
                pattern = [0x7F, 0x49, 0x49, 0x49, 0x36]  # Simple B
            else:
                pattern = [0x00, 0x00, 0x00, 0x00, 0x00]  # Space
                
            # Render pattern
            for row, bits in enumerate(pattern):
                for col in range(5):
                    if bits & (1 << (7-col)):
                        self._set_pixel(x + i*8 + col, y + row, 
                                      self.port['fore_color'])
                        
    def _draw_arc(self, left, top, right, bottom, 
                  start_angle, arc_angle, fill=True):
        """Draw or fill arc/pie wedge"""
        cx = (left + right) / 2
        cy = (top + bottom) / 2
        rx = (right - left) / 2
        ry = (bottom - top) / 2
        
        start_rad = math.radians(start_angle)
        end_rad = math.radians(start_angle + arc_angle)
        
        for y in range(top, bottom):
            for x in range(left, right):
                # Convert to polar coordinates
                dx = x - cx
                dy = y - cy
                
                # Normalize to ellipse
                nx = dx / rx if rx != 0 else 0
                ny = dy / ry if ry != 0 else 0
                
                # Check if inside ellipse
                if nx*nx + ny*ny <= 1:
                    # Check angle
                    angle = math.atan2(dy, dx)
                    if angle < 0:
                        angle += 2 * math.pi
                        
                    if start_angle <= math.degrees(angle) <= start_angle + arc_angle:
                        if fill:
                            self._set_pixel(x, y, self.port['fore_color'])
                        else:
                            # Border only
                            if 0.9 <= nx*nx + ny*ny <= 1.1:
                                self._set_pixel(x, y, self.port['fore_color'])
                                
    def _draw_polygon(self, points, fill=True):
        """Draw or fill polygon"""
        if len(points) < 3:
            return
            
        # Find bounds
        min_x = min(p[0] for p in points)
        max_x = max(p[0] for p in points)
        min_y = min(p[1] for p in points)
        max_y = max(p[1] for p in points)
        
        # Scanline fill
        for y in range(min_y, max_y + 1):
            intersections = []
            
            # Find intersections with polygon edges
            for i in range(len(points)):
                p1 = points[i]
                p2 = points[(i+1) % len(points)]
                
                # Check if edge crosses scanline
                if (p1[1] <= y < p2[1]) or (p2[1] <= y < p1[1]):
                    # Linear interpolation
                    x = p1[0] + (y - p1[1]) * (p2[0] - p1[0]) / (p2[1] - p1[1])
                    intersections.append(int(x))
                    
            intersections.sort()
            
            # Fill between pairs
            for i in range(0, len(intersections), 2):
                if i + 1 < len(intersections):
                    for x in range(intersections[i], intersections[i+1] + 1):
                        self._set_pixel(x, y, self.port['fore_color'])
                        
