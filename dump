    def show(self):
        """Display the QuickDraw canvas in a window"""
        if self.root is None:
            self.root = tk.Tk()
            self.root.title("QuickDraw - Classic Mac Graphics")
            
            # Create canvas for display
            self.canvas_widget = tk.Canvas(
                self.root, 
                width=self.width, 
                height=self.height,
                bg='white'
            )
            self.canvas_widget.pack()
            
            # Add menu bar
            menubar = tk.Menu(self.root)
            self.root.config(menu=menubar)
            
            file_menu = tk.Menu(menubar)
            menubar.add_cascade(label="File", menu=file_menu)
            file_menu.add_command(label="Save as PICT", command=self.save_as_pict)
            file_menu.add_command(label="Clear", command=self.clear)
            file_menu.add_separator()
            file_menu.add_command(label="Quit", command=self.root.quit)
            
            edit_menu = tk.Menu(menubar)
            menubar.add_cascade(label="Edit", menu=edit_menu)
            edit_menu.add_command(label="Copy", command=self.copy)
            
            # Update display
            self.update_display()
            
        self.root.mainloop()
        
    def update_display(self):
        """Update the display canvas"""
        if self.canvas_widget:
            # Convert bytearray to image
            img = Image.new('1', (self.width, self.height))
            pixels = img.load()
            
            for y in range(self.height):
                for x in range(self.width):
                    pixels[x, y] = self._get_pixel(x, y)
                    
            # Convert to PhotoImage
            self.photo = ImageTk.PhotoImage(img)
            self.canvas_widget.create_image(0, 0, image=self.photo, anchor='nw')
            
    def clear(self):
        """Clear canvas to white"""
        self.canvas = bytearray((self.width * self.height) // 8)
        self.update_display()
        
    def save_as_pict(self):
        """Save as PICT format"""
        filename = f"quickdraw_{datetime.now().strftime('%Y%m%d_%H%M%S')}.pict"
        # Simplified - just save as raw
        with open(filename, 'wb') as f:
            f.write(self.canvas)
        print(f"Saved to {filename}")
        
