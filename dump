from flask import Flask, request, jsonify, render_template
from flask_cors import CORS
from engine.books import get_all_books, get_book
from engine.core import generate_curriculum
import json
app = Flask(__name__, template_folder="web/templates", static_folder="web/static")
CORS(app)

@app.route("/")
def index(): return render_template("index.html", books=get_all_books())
@app.route("/api/books")
def api_books(): return jsonify(get_all_books())
@app.route("/api/generate", methods=["POST"])
def api_generate():
    data = request.json
    book_ids = data.get("book_ids", [])
    if not book_ids: return jsonify({"error":"No books selected"}),400
    days = data.get("days_per_layer", 18)
    try:
        curriculum = generate_curriculum(book_ids, days)
        return jsonify({"success":True, "curriculum":curriculum})
    except Exception as e: return jsonify({"error":str(e)}),500
@app.route("/api/export", methods=["POST"])
def api_export():
    data = request.json
    book_ids = data.get("book_ids", [])
    days = data.get("days_per_layer", 18)
    curriculum = generate_curriculum(book_ids, days)
    response = app.response_class(response=json.dumps(curriculum, indent=2), mimetype="application/json")
    response.headers["Content-Disposition"] = "attachment; filename=scrolls.json"
    return response
if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)
