from datetime import date, timedelta
from .books import get_book

BUSINESS_CONCEPTS = {"Fundamental":[{"name":"Output vs Outcome","explanation":"You control effort, not results.","source":"Wattles"}],"Intermediate":[{"name":"Throughput","explanation":"Flow matters more than activity.","source":"Wattles"}],"Advanced":[{"name":"Leverage","explanation":"Results divided by effort.","source":"Musashi"}]}
COMMANDS = {"Awareness":["See clearly."],"Control":["Choose deliberately."],"Identity":["Act as who you are becoming."],"Strategy":["Prepare before acting."],"Advanced":["Leverage your strengths."]}
REPS = ["One deliberate action.","One moment of awareness.","One small step toward your goal."]
SUBTLE = {"Fundamental":"This principle compounds with repetition.","Intermediate":"Notice how this connects to previous concepts.","Advanced":"Leverage compounds exponentially."}

def get_layer(day, dpl=18):
    if day <= dpl: return "Awareness"
    if day <= dpl*2: return "Control"
    if day <= dpl*3: return "Identity"
    if day <= dpl*4: return "Strategy"
    return "Advanced"

def get_business(week):
    if week < 4: return BUSINESS_CONCEPTS["Fundamental"][0]
    if week < 8: return BUSINESS_CONCEPTS["Intermediate"][0]
    return BUSINESS_CONCEPTS["Advanced"][0]

def generate_curriculum(book_ids, days_per_layer=18):
    books = [get_book(bid) for bid in book_ids if get_book(bid)]
    all_quotes = [(b, q) for b in books for q in b.get("quotes",[])]
    if not all_quotes: raise ValueError("No quotes found")
    total_days = days_per_layer * 5
    scrolls = []
    for day in range(1, total_days+1):
        book, quote = all_quotes[(day-1) % len(all_quotes)]
        layer = get_layer(day, days_per_layer)
        week = (day-1)//7
        biz = get_business(week)
        scrolls.append({
            "id": day,
            "date": (date(2026,1,1)+timedelta(days=day-1)).isoformat(),
            "layer": layer,
            "source": book["title"],
            "author": book["author"],
            "year": book["year"],
            "quote": quote,
            "core_principle": book.get("core_principle",""),
            "instruction": book.get("instruction",""),
            "teaching": book["teachings"][day % len(book["teachings"])],
            "context": f"From {book['title']} by {book['author']}: {book.get('instruction','')}",
            "contemplation": f"How does {book['author']}'s teaching apply today?",
            "business_concept": biz["name"],
            "business_explanation": biz["explanation"],
            "business_source": biz["source"],
            "command": COMMANDS[layer][0],
            "rep": REPS[day % len(REPS)],
            "subtle_layer": SUBTLE[biz["name"] in ["Throughput","Margins"] and "Intermediate" or (biz["name"] in ["Leverage","Equity"] and "Advanced" or "Fundamental")],
            "category_tags": [layer, book["domain"]]
        })
    return {"metadata": {"total_days": total_days, "books_used": [b["title"] for b in books]}, "scrolls": scrolls}
