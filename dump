class Rect:
    """QuickDraw Rectangle"""
    def __init__(self, left=0, top=0, right=0, bottom=0):
        self.left = left
        self.top = top
        self.right = right
        self.bottom = bottom
        
    def Pack(self):
        """Pack to Mac format"""
        return struct.pack('>HHHH', self.top, self.left, self.bottom, self.right)

