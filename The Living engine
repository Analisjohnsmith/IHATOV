#!/usr/bin/env python3
"""HELLAV2 - Hella Valrai package manager. One blob: Python + Rust + payload.

This file is both a package manager and the package itself. It embeds the
whole living_engine project (everything except the hellav files and build
output) as a payload section at the bottom, plus a single-file Rust
implementation of the same manager.

Usage:
  python3 hellav2.txt info                 list packed files
  python3 hellav2.txt verify               check every file sha256
  python3 hellav2.txt unpack <dir>         restore the project
  python3 hellav2.txt rust                 write the Rust manager (hellav.rs)
  python3 hellav2.txt pack [<dir>]         rebuild this blob from a project dir

Compile the Rust manager:
  python3 hellav2.txt rust > hellav.rs
  rustc --edition 2021 -O --target x86_64-unknown-linux-musl \\
        -C linker=rust-lld -o hellav hellav.rs
  ./hellav hellav2.txt verify
"""
import base64
import hashlib
import os
import sys

BEGIN = "# __HELLAV_PAYLOAD_BEGIN__"
END = "# __HELLAV_PAYLOAD_END__"
HDR = b"HELLAV-PAYLOAD-1\n"
ENDHDR = b"HELLAV-END\n"
CHUNK = 240

HELLAV_RS = r'''//! Hella Valrai — package manager (Rust implementation).
//!
//! Single-file, no dependencies. Operates on a HELLAV blob (a file such as
//! hellav2.txt). The blob embeds a payload section between
//! `# __HELLAV_PAYLOAD_BEGIN__` and `# __HELLAV_PAYLOAD_END__`; the decoded
//! payload is a manifest (one `<sha256> <size> <path>` line per file) followed
//! by the concatenated file bytes.
//!
//! Usage:
//!   hellav <blob> info
//!   hellav <blob> verify
//!   hellav <blob> unpack <dir>
//!
//! Build: rustc -O -o hellav hellav.rs

use std::env;
use std::fs;
use std::io::Write;
use std::path::{Path, PathBuf};

const BEGIN: &str = "# __HELLAV_PAYLOAD_BEGIN__";
const END: &str = "# __HELLAV_PAYLOAD_END__";
const HDR: &str = "HELLAV-PAYLOAD-1\n";
const ENDHDR: &str = "HELLAV-END\n";

struct Entry {
    path: String,
    size: usize,
    sha: [u8; 32],
}

struct Payload {
    entries: Vec<Entry>,
    data: Vec<u8>,
}

fn b64_decode(packed: &str) -> Vec<u8> {
    fn val(c: u8) -> Option<u32> {
        match c {
            b'A'..=b'Z' => Some((c - b'A') as u32),
            b'a'..=b'z' => Some((c - b'a' + 26) as u32),
            b'0'..=b'9' => Some((c - b'0' + 52) as u32),
            b'+' => Some(62),
            b'/' => Some(63),
            _ => None,
        }
    }
    let mut out = Vec::new();
    let mut acc: u32 = 0;
    let mut bits: u32 = 0;
    for &b in packed.as_bytes() {
        if b == b'=' {
            break;
        }
        let Some(v) = val(b) else { continue };
        acc = (acc << 6) | v;
        bits += 6;
        if bits >= 8 {
            bits -= 8;
            out.push((acc >> bits) as u8);
        }
    }
    out
}

fn sha256(data: &[u8]) -> [u8; 32] {
    const K: [u32; 64] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4,
        0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe,
        0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f,
        0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc,
        0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
        0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116,
        0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
        0xc67178f2,
    ];
    let mut h: [u32; 8] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab,
        0x5be0cd19,
    ];
    let bitlen = (data.len() as u64).wrapping_mul(8);
    let mut msg = data.to_vec();
    msg.push(0x80);
    while msg.len() % 64 != 56 {
        msg.push(0);
    }
    msg.extend_from_slice(&bitlen.to_be_bytes());
    let mut chunks = msg.chunks_exact(64);
    while let Some(chunk) = chunks.next() {
        let mut w = [0u32; 64];
        for i in 0..16 {
            w[i] = u32::from_be_bytes([chunk[i * 4], chunk[i * 4 + 1], chunk[i * 4 + 2], chunk[i * 4 + 3]]);
        }
        for i in 16..64 {
            let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3);
            let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1);
        }
        let [mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut hh] = h;
        for i in 0..64 {
            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            let ch = (e & f) ^ ((!e) & g);
            let t1 = hh.wrapping_add(s1).wrapping_add(ch).wrapping_add(K[i]).wrapping_add(w[i]);
            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = s0.wrapping_add(maj);
            hh = g;
            g = f;
            f = e;
            e = d.wrapping_add(t1);
            d = c;
            c = b;
            b = a;
            a = t1.wrapping_add(t2);
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        h[5] = h[5].wrapping_add(f);
        h[6] = h[6].wrapping_add(g);
        h[7] = h[7].wrapping_add(hh);
    }
    let mut out = [0u8; 32];
    for i in 0..8 {
        out[i * 4..i * 4 + 4].copy_from_slice(&h[i].to_be_bytes());
    }
    out
}

fn hex(v: &[u8]) -> String {
    let mut s = String::with_capacity(v.len() * 2);
    for b in v {
        s.push_str(&format!("{:02x}", b));
    }
    s
}

fn parse_hex(s: &str) -> Result<[u8; 32], String> {
    if s.len() != 64 {
        return Err("bad sha256 length".into());
    }
    let mut out = [0u8; 32];
    for i in 0..32 {
        out[i] = u8::from_str_radix(&s[i * 2..i * 2 + 2], 16).map_err(|e| e.to_string())?;
    }
    Ok(out)
}

fn extract_payload(blob: &str) -> Result<Vec<u8>, String> {
    let begin = blob
        .rfind(BEGIN)
        .ok_or("payload begin marker not found")?;
    let b = &blob[begin + BEGIN.len()..];
    let end = b.rfind(END).ok_or("payload end marker not found")?;
    Ok(b64_decode(&b[..end]))
}

fn parse_payload(payload: &[u8]) -> Result<Payload, String> {
    let s = String::from_utf8_lossy(payload);
    let s = s.strip_prefix(HDR).ok_or("bad payload header")?;
    let mut entries = Vec::new();
    let mut header_bytes = HDR.len();
    let mut seen_end = false;
    for line in s.split('\n') {
        if line.is_empty() {
            continue;
        }
        if line == "HELLAV-END" {
            seen_end = true;
            break;
        }
        let mut it = line.splitn(3, ' ');
        let sha = it.next().ok_or("bad manifest line")?;
        let size = it
            .next()
            .ok_or("bad manifest line")?
            .parse::<usize>()
            .map_err(|e| e.to_string())?;
        let path = it.next().ok_or("bad manifest line")?;
        entries.push(Entry {
            path: path.to_string(),
            size,
            sha: parse_hex(sha)?,
        });
        header_bytes += line.len() + 1;
    }
    if !seen_end {
        return Err("HELLAV-END not found".into());
    }
    header_bytes += ENDHDR.len();
    let data = payload[header_bytes..].to_vec();
    Ok(Payload { entries, data })
}

fn cmd_info(p: &Payload) {
    let mut total = 0usize;
    println!("Hella Valrai package");
    println!("entries: {}", p.entries.len());
    for e in &p.entries {
        total += e.size;
        println!("  {:>10}  {}", e.size, e.path);
    }
    println!("total data: {} bytes", total);
}

fn cmd_verify(p: &Payload) -> bool {
    let mut ok = true;
    let mut off = 0usize;
    for e in &p.entries {
        let end = off + e.size;
        if end > p.data.len() {
            println!("  {}: TRUNCATED", e.path);
            ok = false;
            break;
        }
        let got = sha256(&p.data[off..end]);
        if got != e.sha {
            println!("  {}: SHA256 MISMATCH (got {} want {})", e.path, hex(&got), hex(&e.sha));
            ok = false;
        }
        off = end;
    }
    if off != p.data.len() {
        println!("  trailing {} bytes after last file", p.data.len() - off);
        ok = false;
    }
    ok
}

fn cmd_unpack(p: &Payload, root: &Path) -> Result<(), String> {
    let mut off = 0usize;
    for e in &p.entries {
        let end = off + e.size;
        let data = &p.data[off..end];
        off = end;
        let target = root.join(&e.path);
        if let Some(parent) = target.parent() {
            fs::create_dir_all(parent).map_err(|e| e.to_string())?;
        }
        let mut f = fs::File::create(&target).map_err(|e| e.to_string())?;
        f.write_all(data).map_err(|e| e.to_string())?;
    }
    Ok(())
}

fn usage() {
    eprintln!("hellav <blob> info|verify|unpack <dir>");
}

fn main() {
    let args: Vec<String> = env::args().collect();
    if args.len() < 3 {
        usage();
        std::process::exit(2);
    }
    let blob_path = &args[1];
    let cmd = &args[2];
    let blob = fs::read_to_string(blob_path).expect("read blob");
    let payload = extract_payload(&blob).expect("extract payload");
    let p = parse_payload(&payload).expect("parse payload");
    match cmd.as_str() {
        "info" => cmd_info(&p),
        "verify" => {
            let ok = cmd_verify(&p);
            println!("verify: {}", if ok { "OK" } else { "FAILED" });
            if !ok {
                std::process::exit(1);
            }
        }
        "unpack" => {
            let dir = args
                .get(3)
                .map(PathBuf::from)
                .unwrap_or_else(|| PathBuf::from("."));
            cmd_unpack(&p, &dir).expect("unpack");
            println!("unpacked {} files to {}", p.entries.len(), dir.display());
        }
        _ => {
            usage();
            std::process::exit(2);
        }
    }
}
'''


def read_payload():
    with open(os.path.abspath(__file__), encoding="utf-8") as f:
        text = f.read()
    i = text.rindex(BEGIN) + len(BEGIN)
    j = text.rindex(END)
    chunks = []
    for line in text[i:j].splitlines():
        line = line.strip()
        if line.startswith("#"):
            line = line[1:].strip()
        chunks.append(line)
    return base64.b64decode("".join(chunks))


def parse_payload(payload):
    lines = payload.split(b"\n")
    assert lines[0] == b"HELLAV-PAYLOAD-1", lines[0]
    entries = []
    pos = len(HDR)
    for line in lines[1:]:
        if line == b"HELLAV-END":
            break
        sha, size, path = line.split(b" ", 2)
        entries.append((path.decode("utf-8"), int(size), sha.decode("ascii")))
        pos += len(line) + 1
    pos += len(ENDHDR)
    return entries, payload[pos:]


def cmd_info():
    entries, _ = parse_payload(read_payload())
    total = sum(size for _, size, _ in entries)
    print("Hella Valrai package")
    print("entries: %d" % len(entries))
    for path, size, _ in entries:
        print("  %10d  %s" % (size, path))
    print("total data: %d bytes" % total)


def cmd_verify():
    entries, data = parse_payload(read_payload())
    ok = True
    off = 0
    for path, size, sha in entries:
        chunk = data[off:off + size]
        off += size
        got = hashlib.sha256(chunk).hexdigest()
        if got != sha:
            print("  %s: SHA256 MISMATCH (got %s want %s)" % (path, got, sha))
            ok = False
        else:
            print("  %s: ok" % path)
    if off != len(data):
        print("  trailing %d bytes after last file" % (len(data) - off))
        ok = False
    if ok:
        print("verify: OK (%d files)" % len(entries))
    else:
        print("verify: FAILED")
        sys.exit(1)


def cmd_unpack(dest):
    entries, data = parse_payload(read_payload())
    off = 0
    for path, size, _ in entries:
        chunk = data[off:off + size]
        off += size
        target = os.path.join(dest, path)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "wb") as f:
            f.write(chunk)
    print("unpacked %d files to %s" % (len(entries), dest))


def cmd_rust():
    sys.stdout.write(HELLAV_RS)
    if not HELLAV_RS.endswith("\n"):
        sys.stdout.write("\n")


def build_payload(proj):
    files = []
    for root, dirs, names in os.walk(proj):
        dirs[:] = [d for d in dirs if d != "target"]
        for n in sorted(names):
            if n.startswith("hellav"):
                continue
            rel = os.path.relpath(os.path.join(root, n), proj)
            if os.path.isfile(os.path.join(root, n)):
                files.append(rel)
    files.sort()
    chunks = [HDR]
    data = b""
    for rel in files:
        with open(os.path.join(proj, rel), "rb") as f:
            raw = f.read()
        data += raw
        chunks.append(("%s %d %s\n" % (hashlib.sha256(raw).hexdigest(), len(raw), rel)).encode("utf-8"))
    chunks.append(ENDHDR)
    return files, b"".join(chunks) + data


def cmd_pack(proj):
    here = os.path.abspath(__file__)
    with open(here, encoding="utf-8") as f:
        text = f.read()
    head = text[: text.rindex(BEGIN)]
    proj = os.path.abspath(proj or os.path.dirname(here))
    files, payload = build_payload(proj)
    b64 = base64.b64encode(payload).decode("ascii")
    lines = ["# " + b64[i:i + CHUNK] for i in range(0, len(b64), CHUNK)]
    with open(here, "w", encoding="utf-8") as f:
        f.write(head.rstrip("\n") + "\n")
        f.write(BEGIN + "\n")
        f.write("\n".join(lines) + "\n")
        f.write(END + "\n")
    print("packed %d files, %d payload bytes" % (len(files), len(payload)))


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "help"
    if cmd == "info":
        cmd_info()
    elif cmd == "verify":
        cmd_verify()
    elif cmd == "unpack":
        cmd_unpack(args[1] if len(args) > 1 else ".")
    elif cmd == "rust":
        cmd_rust()
    elif cmd == "pack":
        cmd_pack(args[1] if len(args) > 1 else None)
    else:
        sys.stdout.write(__doc__ or "")
        sys.exit(1)


if __name__ == "__main__":
    main()
