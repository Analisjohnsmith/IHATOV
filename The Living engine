/// Render the cosmic spiral as an ASCII spiral of `radius` rings.
pub fn render_cosmic_spiral(radius: u32) -> Vec<String> {
    let size = (radius * 2 + 1) as i32;
    let center = radius as i32;
    let mut grid = vec![vec![' '; size as usize]; size as usize];

    let mut r = radius as f64;
    while r >= 1.0 {
        let ring = r.round() as i32;
        let phase = if (ring % 2) == 0 { 0.0 } else { std::f64::consts::FRAC_PI_2 };
        let steps = (ring * 24).max(12) as usize;
        for i in 0..steps {
            let t = (i as f64 / steps as f64) * std::f64::consts::TAU + phase;
            let x = center + (ring as f64 * t.cos()).round() as i32;
            let y = center + (ring as f64 * t.sin()).round() as i32;
            if x >= 0 && y >= 0 && (x as usize) < size as usize && (y as usize) < size as usize {
                grid[y as usize][x as usize] = if ring as i32 % 2 == 0 { '◦' } else { '•' };
            }
        }
        // Carve a gap so the ring joins the one inside -> spiral feel.
        for i in 0..3 {
            let t = (i as f64 / 3.0) * std::f64::consts::FRAC_PI_4 + phase;
            let x = center + (ring as f64 * t.cos()).round() as i32;
            let y = center + (ring as f64 * t.sin()).round() as i32;
            if x >= 0 && y >= 0 && (x as usize) < size as usize && (y as usize) < size as usize {
                grid[y as usize][x as usize] = ' ';
            }
        }
        r -= 0.8;
    }

    // Core seal.
    grid[center as usize][center as usize] = '☯';
    if (center as usize + 1) < size as usize {
        grid[(center + 1) as usize][center as usize] = '·';
    }

    grid.into_iter().map(|row| row.into_iter().collect()).collect()
}

// ===========================================================================
// Domain — Hella Engine (festival validator)
// ===========================================================================

#[derive(Debug, Clone)]
pub struct NodeMutation {
    pub name: String,
    pub public_domain: String,
    pub taoism: String,
    pub shinto: String,
    pub objects_of_power: Vec<String>,
    pub words_of_power: Vec<String>,
    pub contexts: Vec<(String, String)>,
}

pub struct HellaEngine {
    pub seal: String,
    pub mode: String,
    pub cycles: Vec<String>,
    pub phases: Vec<(String, Vec<String>)>,
    pub nodes: Vec<NodeMutation>,
}

fn parse_instances(doc: &Value) -> Vec<&Value> {
    match doc.get("instances") {
        Some(Value::Array(items)) => items.iter().collect(),
        _ => Vec::new(),
    }
}

fn build_node(inst: &Value) -> NodeMutation {
    let node_name = inst.get("node").and_then(|v| v.as_str()).unwrap_or("Unknown");
    let tao = TAOISM.get(node_name).copied().unwrap_or("Way-finding");
    let shinto = SHINTO.get(node_name).copied().unwrap_or("Local kami");

    let objects: Vec<String> = inst
        .str_array("motifs")
        .into_iter()
        .filter_map(|m| MOTIF_OBJECTS.get(m.as_str()).map(|s| s.to_string()))
        .collect();
    let words: Vec<String> = inst
        .str_array("effects")
        .into_iter()
        .filter_map(|e| EFFECT_WORDS.get(e.as_str()).map(|s| s.to_string()))
        .collect();
    let contexts = DEFAULT_CONTEXTS
        .iter()
        .map(|(k, v)| (k.to_string(), v.to_string()))
        .collect();

    NodeMutation {
        name: node_name.to_string(),
        public_domain: "Public Domain commons — remix allowed, credit optional".to_string(),
        taoism: tao.to_string(),
        shinto: shinto.to_string(),
        objects_of_power: objects,
        words_of_power: words,
        contexts,
    }
}

impl HellaEngine {
    pub fn load(src: &str) -> Result<Self, String> {
        let doc = parse(src).map_err(|e| e.to_string())?;
        let nodes = parse_instances(&doc)
            .into_iter()
            .map(build_node)
            .collect::<Vec<_>>();
        Ok(HellaEngine {
            seal: doc
                .get("seal")
                .and_then(|v| v.as_str())
                .unwrap_or(PD_SEAL)
                .to_string(),
            mode: "festival".to_string(),
            cycles: CYCLES.iter().map(|s| s.to_string()).collect(),
            phases: PHASES
                .iter()
                .map(|(c, p)| (c.to_string(), p.iter().map(|s| s.to_string()).collect()))
                .collect(),
            nodes,
        })
    }

    pub fn default_spec() -> Result<Self, String> {
        Self::load(include_str!("../assets/matcha.hson"))
    }

    pub fn render_node(&self, node: &NodeMutation, cycle: &str, phase: &str) -> String {
        let mut parts = vec![format!("[{cycle}:{phase}] {}", node.name)];
        parts.push(format!("PD={}", node.public_domain));
        parts.push(format!("Tao={}", node.taoism));
        parts.push(format!("Shinto={}", node.shinto));
        if self.mode == "festival" {
            if !node.objects_of_power.is_empty() {
                parts.push(format!("Objects={}", node.objects_of_power.join(", ")));
            }
            if !node.words_of_power.is_empty() {
                parts.push(format!("Words={}", node.words_of_power.join(", ")));
            }
            for (k, v) in &node.contexts {
                parts.push(format!("{k}={v}"));
            }
        }
        parts.join(" | ")
    }
}

impl Domain for HellaEngine {
    fn id(&self) -> &str {
        "hella"
    }

    fn tick(&self, ctx: &mut DomainContext) -> Vec<WorldOp> {
        let mut ops = Vec::new();
        let phase_idx = PHASES
            .iter()
            .find(|(c, _)| *c == ctx.cycle)
            .map(|(_, p)| p.iter().position(|x| *x == ctx.phase))
            .flatten()
            .unwrap_or(0) as i32;
        for (i, node) in self.nodes.iter().enumerate() {
            let coord = Coord::new(ctx.tick as i32, phase_idx, i as i32);
            if !ctx.world.is_loaded(coord) {
                let mut ent = Entity::new(format!("{}-{}", self.id(), node.name), self.id(), &node.name)
                    .with("cycle", ctx.cycle)
                    .with("phase", ctx.phase);
                if let Some(first) = node.objects_of_power.first() {
                    ent = ent.with("object", first);
                }
                ops.push(WorldOp::Spawn { coord, entity: ent });
            }
        }
        ctx.emit(
            EventKind::NodeStep,
            self.id(),
            &[("nodes", &self.nodes.len().to_string())],
        );
        ops
    }

    fn render(&self, out: &mut dyn Write) -> std::io::Result<()> {
        writeln!(out, "{}", banner(&self.seal, "Hella Validator", &self.mode, 0))?;
        for cycle in &self.cycles {
            for phase in self.phases.iter().find(|(c, _)| c == cycle).map(|(_, p)| p).unwrap_or(&Vec::new()) {
                for node in &self.nodes {
                    writeln!(out, "{}", self.render_node(node, cycle, phase))?;
                }
            }
        }
        writeln!(out, "--- Completion: Tide wash & ritual closure ({}) ---", self.seal)
    }
}

