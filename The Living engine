        });
    }
}

#[derive(Debug, Clone)]
pub struct OmniReality {
    pub realities: HashMap<RealityId, Reality>,
    pub nodes: HashMap<String, CodeNode>,
}

impl OmniReality {
    pub fn new() -> Self {
        OmniReality {
            realities: HashMap::new(),
            nodes: HashMap::new(),
        }
    }

    pub fn get_reality(&mut self, id: RealityId) -> &mut Reality {
        self.realities
            .entry(id.clone())
            .or_insert_with(|| Reality {
                id: id.clone(),
                spaces: HashMap::new(),
            })
    }

    pub fn create_node(
        &mut self,
        id: impl Into<String>,
        code: impl Into<String>,
        life: Option<LifeNode>,
    ) -> CodeNode {
        let node = CodeNode::new(id.into(), code, life);
        self.nodes.insert(node.id.clone(), node.clone());
        node
    }

    pub fn place_node(&mut self, node: &mut CodeNode, reality: RealityId, shape: &str, coord: &str) {
        self.get_reality(reality).place_node(node, shape, coord);
    }

    /// Evolve every node: update life from grid neighbors, record history.
    pub fn step_all(&mut self, tick: u64) {
        let mut next_life: HashMap<String, LifeNode> = HashMap::new();

        if let Some(code_world) = self.realities.get(&RealityId::Code) {
            if let Some(grid) = code_world.spaces.get("grid") {
                for (coord, nodes) in &grid.cells {
                    let nb: Vec<CodeNode> = Self::grid_neighbors(coord, grid);
                    let neighbors: Vec<&LifeNode> =
                        nb.iter().filter_map(|n| n.life.as_ref()).collect();
                    for node in nodes {
                        if let Some(life) = &node.life {
                            next_life.insert(node.id.clone(), life.next_state(&neighbors));
                        }
                    }
                }
            }
        }

        for node in self.nodes.values_mut() {
            node.step(tick);
            if let Some(life) = &node.life {
                let next = next_life.get(&node.id).cloned().unwrap_or_else(|| life.clone());
                node.life = Some(next);
                let life = node.life.as_ref().unwrap();
                node.meta.insert("glyph".into(), life.glyph.clone());
                node.meta.insert("alive".into(), life.alive.to_string());
            }
        }
    }

    fn grid_neighbors(coord: &str, grid: &ShapeSpace) -> Vec<CodeNode> {
        let parts: Vec<i32> = coord
            .split(',')
            .filter_map(|p| p.trim().parse().ok())
            .collect();
        if parts.len() != 2 {
            return Vec::new();
        }
        let (x, y) = (parts[0], parts[1]);
        let mut out = Vec::new();
        for dx in -1..=1 {
            for dy in -1..=1 {
                if dx == 0 && dy == 0 {
                    continue;
                }
                let key = format!("{},{}", x + dx, y + dy);
                if let Some(nodes) = grid.cells.get(&key) {
                    out.extend(nodes.iter().cloned());
                }
            }
        }
        out
    }
}

#[derive(Debug, Clone)]
pub struct RuntimeEvent {
    pub tick: u64,
    pub description: String,
    pub payload: String,
}

struct MarrowInner {
    omni: OmniReality,
    tick: u64,
    log: Vec<RuntimeEvent>,
}

pub struct Marrowweave {
    inner: std::sync::Mutex<MarrowInner>,
    seal: String,
}

impl Marrowweave {
    pub fn new() -> Self {
        let mut omni = OmniReality::new();

        let traits: &[&str] = &[
            "Cooperation",
            "Resilience",
            "Curiosity",
            "Wisdom",
            "Empathy",
            "Chaos",
            "Memory",
            "Transformation",
            "Joy",
            "Competition",
            "Completion",
        ];

        for (i, t) in traits.iter().enumerate() {
            let code = format!("({}) -> spiral", t);
            let mut node = omni.create_node(
                format!("trait_{i}"),
                code,
                Some(LifeNode::new(false)),
            );
            node.meta.insert("trait".into(), t.to_string());
            omni.place_node(&mut node, RealityId::Code, "grid", &format!("{},{}", i % 5, i / 5));
            omni.place_node(&mut node, RealityId::Data, "line", &format!("{i}"));
            omni.place_node(&mut node, RealityId::Logic, "tree", &format!("root/arm_{i}"));
            omni.nodes.insert(node.id.clone(), node);
        }

        // Glider: the smallest spacecraft, seeded in a clear region of the
        // grid so it visibly moves across ticks.
        let glider = [(5, 0), (6, 1), (4, 2), (5, 2), (6, 2)];
        for (i, (gx, gy)) in glider.iter().enumerate() {
            let mut node = omni.create_node(
                format!("glider_{i}"),
                "life".to_string(),
                Some(LifeNode::new(true)),
            );
            node.meta.insert("trait".into(), "Chaos".into());
            omni.place_node(&mut node, RealityId::Code, "grid", &format!("{gx},{gy}"));
            omni.nodes.insert(node.id.clone(), node);
        }

        Marrowweave {
            inner: std::sync::Mutex::new(MarrowInner {
                omni,
                tick: 0,
                log: Vec::new(),
            }),
            seal: PD_SEAL.to_string(),
        }
    }

    /// Advance the cellular automaton one tick (used by the domain loop).
    pub fn step(&self) {
        let mut inner = self.inner.lock().unwrap();
        inner.tick += 1;
        let tick = inner.tick;
        inner.omni.step_all(tick);
        let nodes = inner.omni.nodes.len();
        inner.log.push(RuntimeEvent {
            tick,
            description: "step_complete".into(),
            payload: format!("nodes={nodes}"),
        });
    }

    pub fn tick_count(&self) -> u64 {
        self.inner.lock().unwrap().tick
    }

    /// Build the observation map described in the spec's `observe()`.
    pub fn observe(&self) -> String {
        let inner = self.inner.lock().unwrap();
        Self::observe_locked(&inner)
    }

    fn observe_locked(inner: &MarrowInner) -> String {
        let mut out = String::new();
        out.push_str(&format!(
            "tick={} realities=",
            inner.tick
        ));
        let mut realities: Vec<&RealityId> = inner.omni.realities.keys().collect();
        realities.sort_by_key(|r| r.as_str());
        for rid in realities {
            let r = &inner.omni.realities[rid];
            let mut shapes: Vec<&str> = r.spaces.keys().map(|s| s.as_str()).collect();
            shapes.sort();
            out.push_str(&format!("{}[{}] ", rid.as_str(), shapes.join(",")));
        }
        out.push('\n');
        for nid in sorted_keys(&inner.omni.nodes) {
            let n = inner.omni.nodes.get(&nid).unwrap();
            let positions: Vec<String> = n
                .positions
                .iter()
                .map(|p| format!("{}:{}/{}", p.reality.as_str(), p.shape, p.coord))
                .collect();
            let glyph = n.meta.get("glyph").map(|s| s.as_str()).unwrap_or("·");
            out.push_str(&format!(
                "{:<10} code={:<16} life={} positions=[{}] history={}\n",
                nid,
                n.code,
                glyph,
                positions.join(", "),
                n.history.len()
            ));
        }
        out
    }
}

fn sorted_keys<K: Ord + Clone, V>(map: &HashMap<K, V>) -> Vec<K> {
    let mut keys: Vec<K> = map.keys().cloned().collect();
    keys.sort();
    keys
}

impl Domain for Marrowweave {
    fn id(&self) -> &str {
        "marrow"
    }

    fn tick(&self, ctx: &mut DomainContext) -> Vec<WorldOp> {
        self.step();
        let inner = self.inner.lock().unwrap();
        ctx.emit(
            EventKind::StepComplete,
            self.id(),
            &[("nodes", &inner.omni.nodes.len().to_string())],
        );
        let alive = inner
            .omni
            .nodes
            .values()
            .filter(|n| n.life.as_ref().map(|l| l.alive).unwrap_or(false))
            .count();
        ctx.emit(
            EventKind::Resonance,
            self.id(),
            &[("alive", &alive.to_string()), ("realities", &inner.omni.realities.len().to_string())],
        );
        Vec::new()
    }

    fn render(&self, out: &mut dyn Write) -> std::io::Result<()> {
        let inner = self.inner.lock().unwrap();
        writeln!(
            out,
            "{}",
            banner(&self.seal, "Marrowweave — OmniReality", "marrow", inner.tick)
        )?;
        if let Some(code_world) = inner.omni.realities.get(&RealityId::Code) {
            if let Some(grid) = code_world.spaces.get("grid") {
                let max = grid.cells.keys().filter_map(|k| {
                    let p: Vec<i32> = k.split(',').filter_map(|c| c.trim().parse().ok()).collect();
                    p.first().copied()
                }).max().unwrap_or(0);
                writeln!(out, "CodeWorld grid (0..={max}):")?;
                for y in 0..=max {
                    let mut row = String::new();
                    for x in 0..=max {
                        let key = format!("{x},{y}");
                        let cell = grid.cells.get(&key).cloned().unwrap_or_default();
                        let glyph = if cell.iter().any(|n| n.life.as_ref().map(|l| l.alive).unwrap_or(false)) {
                            "•"
                        } else if cell.is_empty() {
                            "·"
                        } else {
                            "_"
                        };
                        row.push_str(&format!(" {glyph} "));
                    }
                    writeln!(out, "{row}")?;
                }
            }
        }
        writeln!(out, "observe():")?;
        write!(out, "{}", Self::observe_locked(&inner))?;
        Ok(())
    }
}

impl Default for Marrowweave {
    fn default() -> Self {
        Self::new()
    }
}

