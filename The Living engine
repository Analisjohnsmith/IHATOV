/// A mutation a domain wants applied to the world container.
#[derive(Debug, Clone)]
pub enum WorldOp {
    Spawn {
        coord: Coord,
        entity: Entity,
    },
}

/// Everything a domain needs on a given tick. The world is a read-only
/// snapshot for queries; changes are expressed as `WorldOp`s.
pub struct DomainContext<'a> {
    pub tick: u64,
    pub cycle: &'a str,
    pub phase: &'a str,
    pub bus: &'a EventBus,
    pub world: &'a World,
}

impl<'a> DomainContext<'a> {
    pub fn emit(&self, kind: EventKind, origin: impl Into<String>, data: &[(&str, &str)]) {
        let mut e = Event::new(kind, origin, self.tick);
        for (k, v) in data {
            e = e.with(*k, *v);
        }
        self.bus.publish(e);
    }
}

pub trait Domain: Send + Sync {
    fn id(&self) -> &str;

    /// Advance the domain one step against a read-only world snapshot.
    /// Returns world mutations to be applied at the sync point.
    fn tick(&self, ctx: &mut DomainContext) -> Vec<WorldOp>;

    /// Render the domain's current state as text.
    fn render(&self, out: &mut dyn io::Write) -> io::Result<()>;
}

/// Banner shared by all domains — the seal of the Book of the Living.
pub fn banner(pd_seal: &str, name: &str, mode: &str, tick: u64) -> String {
    let mut s = String::new();
    let _ = write!(s, "=== {} {name} (tick={tick}, mode={mode}) ===", pd_seal);
    s
}

// ===========================================================================
// Engine core — job scheduler
// ===========================================================================

type Job = Box<dyn FnOnce() + Send + 'static>;

pub struct Scheduler {
    queue: Arc<Mutex<VecDeque<Job>>>,
    cv: Arc<Condvar>,
    pending: Arc<AtomicUsize>,
    shutdown: Arc<AtomicBool>,
    workers: Vec<std::thread::JoinHandle<()>>,
    threads: usize,
}

impl Scheduler {
    pub fn new(threads: usize) -> Self {
        let threads = threads.max(1);
        let queue: Arc<Mutex<VecDeque<Job>>> = Arc::new(Mutex::new(VecDeque::new()));
        let cv = Arc::new(Condvar::new());
        let pending = Arc::new(AtomicUsize::new(0));
        let shutdown = Arc::new(AtomicBool::new(false));

        let mut workers = Vec::with_capacity(threads);
        for _ in 0..threads {
            let queue = queue.clone();
            let cv = cv.clone();
            let pending = pending.clone();
            let shutdown = shutdown.clone();
            workers.push(std::thread::spawn(move || loop {
                let job = {
                    let mut q = queue.lock().unwrap();
                    while q.is_empty() && !shutdown.load(Ordering::Relaxed) {
                        q = cv.wait(q).unwrap();
                    }
                    q.pop_front()
                };
                match job {
                    Some(job) => {
                        job();
                        if pending.fetch_sub(1, Ordering::SeqCst) == 1 {
                            cv.notify_all();
                        }
                    }
                    None => {
                        if shutdown.load(Ordering::SeqCst) {
                            break;
                        }
                    }
                }
            }));
        }

        Scheduler {
            queue,
            cv,
            pending,
            shutdown,
            workers,
            threads,
        }
    }

    /// Submit a single job.
    pub fn spawn<F: FnOnce() + Send + 'static>(&self, job: F) {
        self.pending.fetch_add(1, Ordering::SeqCst);
        self.queue.lock().unwrap().push_back(Box::new(job));
        self.cv.notify_one();
    }

    /// Run `f(i)` for every item in `range` across the pool, blocking until done.
    pub fn parallel_for<F>(&self, range: std::ops::Range<usize>, f: F)
    where
        F: Fn(usize) + Send + Sync + 'static,
    {
        let f = Arc::new(f);
        for i in range {
            let f = f.clone();
            self.spawn(move || f(i));
        }
        self.wait_idle();
    }

    /// Block until all submitted jobs complete.
    pub fn wait_idle(&self) {
        let mut q = self.queue.lock().unwrap();
        while self.pending.load(Ordering::SeqCst) > 0 {
            q = self.cv.wait(q).unwrap();
        }
    }

    pub fn threads(&self) -> usize {
        self.threads
    }

    pub fn pending(&self) -> usize {
        self.pending.load(Ordering::SeqCst)
    }
}

impl Drop for Scheduler {
    fn drop(&mut self) {
        {
            let _guard = self.queue.lock().unwrap();
            self.shutdown.store(true, Ordering::SeqCst);
        }
        self.cv.notify_all();
        for w in self.workers.drain(..) {
            w.join().ok();
        }
    }
}

// ===========================================================================
// Engine core — runtime
// ===========================================================================

pub struct Runtime {
    pub bus: Arc<EventBus>,
    pub world: World,
    pub scheduler: Scheduler,
    domains: Vec<Box<dyn Domain>>,
    pub tick: u64,
}

impl Runtime {
    pub fn new(threads: usize) -> Self {
        Runtime {
            bus: Arc::new(EventBus::new()),
            world: World::new(),
            scheduler: Scheduler::new(threads),
            domains: Vec::new(),
            tick: 0,
        }
    }

    pub fn register(&mut self, domain: Box<dyn Domain>) -> &mut Self {
        self.domains.push(domain);
        self
    }

    pub fn domains(&self) -> &[Box<dyn Domain>] {
        &self.domains
    }

    /// Advance every domain one cycle/phase. Domain ticks run in parallel
    /// (scoped threads), the resulting world ops are applied serially, then
    /// the world streams chunks around its focus.
    pub fn step(&mut self, cycle: &str, phase: &str) {
        self.tick += 1;
        let tick = self.tick;

        let snapshot = Arc::new(self.world.clone());
        let results: Arc<Mutex<Vec<(usize, Vec<WorldOp>)>>> = Arc::new(Mutex::new(Vec::new()));
        let bus = self.bus.clone();
        let domains = &self.domains;
        let n = domains.len();

        std::thread::scope(|s| {
            for i in 0..n {
                let snapshot = snapshot.clone();
                let results = results.clone();
                let bus = bus.clone();
                let cycle = cycle.to_string();
                let phase = phase.to_string();
                s.spawn(move || {
                    let ops = domains[i].tick(&mut DomainContext {
                        tick,
                        cycle: &cycle,
                        phase: &phase,
                        bus: &bus,
                        world: &snapshot,
                    });
                    results.lock().unwrap().push((i, ops));
                });
            }
        });

        // Serial apply phase: merge ops in domain registration order.
        let mut ordered: Vec<Vec<WorldOp>> = Vec::with_capacity(n);
        ordered.resize_with(n, Vec::new);
        for (i, ops) in results.lock().unwrap().iter() {
            ordered[*i] = ops.clone();
        }
        for ops in ordered {
            for op in ops {
                match op {
                    WorldOp::Spawn { coord, entity } => {
                        self.world.spawn(coord, entity, &self.bus, tick);
                    }
                }
            }
        }

        // Streaming pass: unload chunks outside the focus radius.
        self.world.stream(&self.bus, tick);
    }

    /// Render all registered domains sequentially.
    pub fn render_all(&self) -> io::Result<()> {
        let stdout = io::stdout();
        let mut out = stdout.lock();
        for domain in self.domains.iter() {
            domain.render(&mut out)?;
            writeln!(out)?;
        }
        out.flush()
    }

    /// Render one domain by id.
    pub fn render_domain(&self, id: &str) -> io::Result<()> {
        let stdout = io::stdout();
        let mut out = stdout.lock();
        if let Some(d) = self.domains.iter().find(|d| d.id() == id) {
            d.render(&mut out)?;
            writeln!(out)?;
        }
        out.flush()
    }
}

// ===========================================================================
// HSON — tolerant HSON/HJSON parser
// ===========================================================================

#[derive(Debug, Clone, PartialEq)]
pub enum Value {
    Null,
    Bool(bool),
    Number(f64),
    Str(String),
    Array(Vec<Value>),
    Object(HashMap<String, Value>),
}

impl Value {
    pub fn get(&self, key: &str) -> Option<&Value> {
        match self {
            Value::Object(map) => map.get(key),
            _ => None,
        }
    }

    pub fn as_str(&self) -> Option<&str> {
        match self {
            Value::Str(s) => Some(s),
            _ => None,
        }
    }

    pub fn as_f64(&self) -> Option<f64> {
        match self {
            Value::Number(n) => Some(*n),
            Value::Bool(b) => Some(if *b { 1.0 } else { 0.0 }),
            _ => None,
        }
    }

    pub fn as_bool(&self) -> Option<bool> {
        match self {
            Value::Bool(b) => Some(*b),
            _ => None,
        }
    }

    pub fn as_array(&self) -> Option<&[Value]> {
        match self {
            Value::Array(a) => Some(a),
            _ => None,
        }
    }

    pub fn as_object(&self) -> Option<&HashMap<String, Value>> {
        match self {
            Value::Object(o) => Some(o),
            _ => None,
        }
    }

    /// Get a string array field, returning empty vec if missing.
    pub fn str_array(&self, key: &str) -> Vec<String> {
        match self.get(key) {
            Some(Value::Array(items)) => items
                .iter()
                .filter_map(|v| v.as_str().map(|s| s.to_string()))
                .collect(),
            _ => Vec::new(),
        }
    }

    pub fn string_array(&self, key: &str) -> Vec<String> {
        self.str_array(key)
    }
}

impl fmt::Display for Value {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Value::Null => write!(f, "null"),
            Value::Bool(b) => write!(f, "{b}"),
            Value::Number(n) => write!(f, "{n}"),
            Value::Str(s) => write!(f, "\"{s}\""),
            Value::Array(a) => {
                write!(f, "[")?;
                for (i, v) in a.iter().enumerate() {
                    if i > 0 {
                        write!(f, ", ")?;
                    }
                    write!(f, "{v}")?;
                }
                write!(f, "]")
            }
            Value::Object(o) => {
                write!(f, "{{")?;
                for (i, (k, v)) in o.iter().enumerate() {
                    if i > 0 {
                        write!(f, ", ")?;
                    }
                    write!(f, "{k}: {v}")?;
                }
                write!(f, "}}")
            }
        }
    }
}

/// A minimal, tolerant HSON/HJSON parser.
///
/// Handles the subset used by the Book of the Living spec:
/// objects with unquoted keys, arrays with trailing commas, `//` comments,
/// quoted strings, bare-word strings, numbers, booleans, and null.
pub struct Parser<'a> {
    _src: &'a str,
    chars: Vec<char>,
    pos: usize,
}

#[derive(Debug)]
pub struct HsonError {
    pub pos: usize,
    pub message: String,
}

impl fmt::Display for HsonError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "HSON error at byte {}: {}", self.pos, self.message)
    }
}

impl std::error::Error for HsonError {}

type HsonResult<T> = std::result::Result<T, HsonError>;

pub fn parse(src: &str) -> HsonResult<Value> {
    let chars: Vec<char> = src.chars().collect();
    let mut p = Parser { _src: src, chars, pos: 0 };
    p.skip_ws();
    // HJSON documents may be a bare object with no enclosing braces.
    let v = match p.peek() {
        Some('{') | Some('[') => p.parse_value()?,
        _ => p.parse_root_object()?,
    };
    p.skip_ws();
    if p.pos < p.chars.len() {
        return Err(HsonError {
            pos: p.pos,
            message: format!("unexpected trailing content: {:?}", p.chars[p.pos]),
        });
    }
    Ok(v)
}

impl<'a> Parser<'a> {
    fn peek(&self) -> Option<char> {
        self.chars.get(self.pos).copied()
    }

    fn bump(&mut self) -> Option<char> {
        let c = self.chars.get(self.pos).copied();
        if c.is_some() {
            self.pos += 1;
        }
        c
    }

    fn skip_ws(&mut self) {
        loop {
            match self.peek() {
                Some(c) if c.is_whitespace() => {
                    self.pos += 1;
                }
                Some('/') if self.chars.get(self.pos + 1) == Some(&'/') => {
                    while let Some(c) = self.peek() {
                        if c == '\n' {
                            break;
                        }
                        self.pos += 1;
                    }
                }
                _ => break,
            }
        }
    }

    fn expect(&mut self, expected: char) -> HsonResult<()> {
        match self.bump() {
            Some(c) if c == expected => Ok(()),
            other => Err(HsonError {
                pos: self.pos,
                message: format!("expected '{expected}', got {:?}", other),
            }),
        }
    }

    fn parse_value(&mut self) -> HsonResult<Value> {
        self.skip_ws();
        match self.peek() {
            Some('{') => self.parse_object(),
            Some('[') => self.parse_array(),
            Some('"') => self.parse_quoted(),
            Some('t') | Some('f') => self.parse_bool(),
            Some('n') => self.parse_null(),
            Some(c) if c == '-' || c.is_ascii_digit() => self.parse_number(),
            Some(c) if is_bare_char(c) => self.parse_bare(),
            Some(c) => Err(HsonError {
                pos: self.pos,
                message: format!("unexpected character {:?}", c),
            }),
            None => Err(HsonError {
                pos: self.pos,
                message: "unexpected end of input".to_string(),
            }),
        }
    }

    fn parse_object(&mut self) -> HsonResult<Value> {
        self.expect('{')?;
        let mut map = HashMap::new();
        loop {
            self.skip_ws();
            match self.peek() {
                None => {
                    return Err(HsonError {
                        pos: self.pos,
                        message: "unterminated object".to_string(),
                    })
                }
                Some('}') => {
                    self.pos += 1;
                    break;
                }
                _ => {}
            }
            let key = self.parse_key()?;
            self.skip_ws();
            self.expect(':')?;
            let value = self.parse_value()?;
            map.insert(key, value);
            self.skip_ws();
            match self.peek() {
                Some(',') => {
                    self.pos += 1;
                }
                Some('}') => {
                    self.pos += 1;
                    break;
                }
                // HSON-ish: entries may be separated by whitespace/newlines
                // with no comma at all.
                Some(_) => {}
                None => {
                    return Err(HsonError {
                        pos: self.pos,
                        message: "unterminated object".to_string(),
                    })
                }
            }
        }
        Ok(Value::Object(map))
    }

    /// Parse a brace-less root object: a document of `key: value` pairs,
    /// also accepting the wrapped form `Name { ... }` (no colon).
    fn parse_root_object(&mut self) -> HsonResult<Value> {
        let mut map = HashMap::new();
        loop {
            self.skip_ws();
            if self.pos >= self.chars.len() {
                break;
            }
            let key = self.parse_key()?;
            self.skip_ws();
            let value = match self.peek() {
                Some('{') => self.parse_object()?,
                _ => {
                    self.expect(':')?;
                    self.parse_value()?
                }
            };
            map.insert(key, value);
            self.skip_ws();
            match self.peek() {
                Some(',') => {
                    self.pos += 1;
                }
                Some(_) => {}
                None => break,
            }
        }
        Ok(Value::Object(map))
    }

    fn parse_array(&mut self) -> HsonResult<Value> {
        self.expect('[')?;
        let mut items = Vec::new();
        loop {
            self.skip_ws();
            match self.peek() {
                None => {
                    return Err(HsonError {
                        pos: self.pos,
                        message: "unterminated array".to_string(),
                    })
                }
                Some(']') => {
                    self.pos += 1;
                    break;
                }
                _ => {}
            }
            let value = self.parse_value()?;
            items.push(value);
            self.skip_ws();
            match self.peek() {
                Some(',') => {
                    self.pos += 1;
                }
                Some(']') => {
                    self.pos += 1;
                    break;
                }
                // HSON-ish: array items may be whitespace-separated with no
                // commas (e.g. `SpiralArms: [ {..} {..} ]`).
                Some(_) => {}
                None => {
                    return Err(HsonError {
                        pos: self.pos,
                        message: "unterminated array".to_string(),
                    })
                }
            }
        }
        Ok(Value::Array(items))
    }

    fn parse_key(&mut self) -> HsonResult<String> {
        self.skip_ws();
        match self.peek() {
            Some('"') => self.parse_quoted(),
            Some(c) if is_bare_char(c) => self.parse_bare(),
            other => Err(HsonError {
                pos: self.pos,
                message: format!("invalid object key start {:?}", other),
            }),
        }
        .and_then(|v| match v {
            Value::Str(s) => Ok(s),
            _ => unreachable!("key parsed as non-string"),
        })
    }

    fn parse_quoted(&mut self) -> HsonResult<Value> {
        self.expect('"')?;
        let mut out = String::new();
        loop {
            match self.bump() {
                Some('"') => break,
                Some('\\') => match self.bump() {
                    Some('n') => out.push('\n'),
                    Some('t') => out.push('\t'),
                    Some('r') => out.push('\r'),
                    Some('"') => out.push('"'),
                    Some('\\') => out.push('\\'),
                    Some('/') => out.push('/'),
                    Some('u') => {
                        let mut hex = String::new();
                        for _ in 0..4 {
                            match self.bump() {
                                Some(c) if c.is_ascii_hexdigit() => hex.push(c),
                                _ => {
                                    return Err(HsonError {
                                        pos: self.pos,
                                        message: "invalid \\u escape".to_string(),
                                    })
                                }
                            }
                        }
                        if let Ok(cp) = u32::from_str_radix(&hex, 16) {
                            if let Some(c) = char::from_u32(cp) {
                                out.push(c);
                            }
                        }
                    }
                    other => {
                        return Err(HsonError {
                            pos: self.pos,
                            message: format!("invalid escape {:?}", other),
                        })
                    }
                },
                Some(c) => out.push(c),
                None => {
                    return Err(HsonError {
                        pos: self.pos,
                        message: "unterminated string".to_string(),
                    })
                }
            }
        }
        Ok(Value::Str(out))
    }

    fn parse_bare(&mut self) -> HsonResult<Value> {
        let start = self.pos;
        while let Some(c) = self.peek() {
            if !is_bare_char(c) {
                break;
            }
            self.pos += 1;
        }
        let word: String = self.chars[start..self.pos].iter().collect();
        Ok(Value::Str(word))
    }

    fn parse_bool(&mut self) -> HsonResult<Value> {
        let start = self.pos;
        while let Some(c) = self.peek() {
            if !c.is_ascii_alphanumeric() {
                break;
            }
            self.pos += 1;
        }
        let word: String = self.chars[start..self.pos].iter().collect();
        match word.as_str() {
            "true" => Ok(Value::Bool(true)),
            "false" => Ok(Value::Bool(false)),
            _ => Err(HsonError {
                pos: start,
                message: format!("invalid literal {:?}", word),
            }),
        }
    }

    fn parse_null(&mut self) -> HsonResult<Value> {
        let start = self.pos;
        while let Some(c) = self.peek() {
            if !c.is_ascii_alphanumeric() {
                break;
            }
            self.pos += 1;
        }
        let word: String = self.chars[start..self.pos].iter().collect();
        if word == "null" {
            Ok(Value::Null)
        } else {
            Err(HsonError {
                pos: start,
                message: format!("invalid literal {:?}", word),
            })
        }
    }

    fn parse_number(&mut self) -> HsonResult<Value> {
        let start = self.pos;
        if self.peek() == Some('-') {
            self.pos += 1;
        }
        while let Some(c) = self.peek() {
            if c.is_ascii_digit() || c == '.' || c == 'e' || c == 'E' || c == '+' || c == '-' {
                self.pos += 1;
            } else {
                break;
            }
        }
        let text: String = self.chars[start..self.pos].iter().collect();
        text.parse::<f64>()
            .map(Value::Number)
            .map_err(|_| HsonError {
                pos: start,
                message: format!("invalid number {:?}", text),
            })
    }
}

fn is_bare_char(c: char) -> bool {
    c.is_ascii_alphanumeric() || c == '_' || c == '.' || c == '-' || c == '/' || c == '☯'
}

/// Parse the `ValidatorSpiral { ... }` wrapper and return its contents.
pub fn parse_wrapped_object(src: &str) -> HsonResult<Value> {
    let v = parse(src)?;
    Ok(v)
}

