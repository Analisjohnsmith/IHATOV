pub const SHAPES: &[&str] = &["line", "grid", "volume", "graph", "tree", "cloud", "hyper"];

#[derive(Debug, Clone, PartialEq, Eq, Hash)]
pub enum RealityId {
    Code,
    Logic,
    Data,
}

impl RealityId {
    pub fn as_str(&self) -> &'static str {
        match self {
            RealityId::Code => "CodeWorld",
            RealityId::Logic => "LogicWorld",
            RealityId::Data => "DataWorld",
