#[cfg(test)]
mod tests_marrow {
    use super::*;

    #[test]
    fn life_transitions() {
        let l = LifeNode::new(true);
        // Under-population: 1 neighbor -> dies
        let one: Vec<LifeNode> = vec![LifeNode::new(true)];
        let ns: Vec<&LifeNode> = one.iter().collect();
        assert!(!l.next_state(&ns).alive);
        // Survival: 2 neighbors -> survives
        let two: Vec<LifeNode> = vec![LifeNode::new(true), LifeNode::new(true)];
        let ns: Vec<&LifeNode> = two.iter().collect();
        assert!(l.next_state(&ns).alive);
    }

    #[test]
    fn glider_moves() {
        let m = Marrowweave::new();
        let alive_before = m
            .inner
            .lock()
            .unwrap()
            .omni
            .nodes
            .values()
            .filter(|n| n.life.as_ref().map(|l| l.alive).unwrap_or(false))
            .count();
        assert!(alive_before >= 5);
        m.step();
        let alive_after = m
            .inner
            .lock()
            .unwrap()
            .omni
            .nodes
            .values()
            .filter(|n| n.life.as_ref().map(|l| l.alive).unwrap_or(false))
            .count();
        assert!(alive_after > 0);
        assert!(m.tick_count() == 1);
        assert_eq!(m.inner.lock().unwrap().log.len(), 1);
    }

    #[test]
    fn nodes_exist_across_realities() {
        let m = Marrowweave::new();
        let inner = m.inner.lock().unwrap();
        assert_eq!(inner.omni.realities.len(), 3);
        let n = inner.omni.nodes.get("trait_0").unwrap();
        assert!(n.positions.len() == 3, "expected 3 positions, got {}", n.positions.len());
        // Glider nodes live only on the grid.
        let g = inner.omni.nodes.get("glider_0").unwrap();
        assert_eq!(g.positions.len(), 1);
    }
}
