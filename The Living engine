
//! Core (open, BOL-OC 1.0): runtime, job scheduler, domain loader, chunked
//! world container, event system. Domains (portable): Hella Engine,
//! ValidatorSpiral, KittyOS, Marrowweave.
//!
//! Architecture (RAGE-style): a job scheduler fans domain ticks out to worker
//! threads against a read-only world snapshot, ops are applied at a serial
//! sync point, and a chunked world container streams entities around a focus.

use std::collections::{HashMap, VecDeque};
use std::fmt;
use std::fmt::Write as _;
use std::io::{self, Write};
use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
use std::sync::{Arc, Condvar, LazyLock, Mutex};

