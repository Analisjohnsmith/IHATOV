        let seen = Arc::new(Mutex::new(Vec::new()));
        let seen2 = seen.clone();
        bus.subscribe(Arc::new(move |e: &Event| {
            seen2.lock().unwrap().push(e.origin.clone());
        }));
        bus.publish(Event::new(EventKind::Tick, "runtime", 1));
        bus.publish(Event::new(EventKind::NodeStep, "hella", 1));
        assert_eq!(bus.history().len(), 2);
        assert_eq!(bus.on_tick(1).len(), 2);
        assert_eq!(bus.count(EventKind::Tick), 1);
        assert_eq!(seen.lock().unwrap().as_slice(), ["runtime", "hella"]);
    }
}

