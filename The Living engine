#[derive(Debug, Clone)]
pub struct Event {
    pub kind: EventKind,
    pub origin: String,
    pub tick: u64,
    pub data: HashMap<String, String>,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub enum EventKind {
    Tick,
    NodeStep,
    Mutation,
    Ritual,
    Resonance,
    Spawn,
    Streaming,
    StepComplete,
    Thought,
}

impl EventKind {
    pub fn as_str(&self) -> &'static str {
        match self {
            EventKind::Tick => "tick",
            EventKind::NodeStep => "node_step",
            EventKind::Mutation => "mutation",
            EventKind::Ritual => "ritual",
            EventKind::Resonance => "resonance",
            EventKind::Spawn => "spawn",
            EventKind::Streaming => "streaming",
            EventKind::StepComplete => "step_complete",
            EventKind::Thought => "thought",
        }
    }
}

impl Event {
    pub fn new(kind: EventKind, origin: impl Into<String>, tick: u64) -> Self {
        Event {
            kind,
            origin: origin.into(),
            tick,
            data: HashMap::new(),
        }
    }

    pub fn with(mut self, key: impl Into<String>, value: impl Into<String>) -> Self {
        self.data.insert(key.into(), value.into());
        self
    }
}

#[derive(Default)]
pub struct EventBus {
    inner: Mutex<Vec<Event>>,
    listeners: Mutex<Vec<Arc<dyn Fn(&Event) + Send + Sync>>>,
}

impl EventBus {
    pub fn new() -> Self {
        Self::default()
    }

    pub fn publish(&self, event: Event) {
        let listeners = self.listeners.lock().unwrap();
        {
            let mut log = self.inner.lock().unwrap();
            let len = log.len();
            if len > 4096 {
                log.drain(..len - 1024);
            }
            log.push(event.clone());
        }
        for listener in listeners.iter() {
            listener(&event);
        }
    }

    pub fn subscribe(&self, listener: Arc<dyn Fn(&Event) + Send + Sync>) {
        self.listeners.lock().unwrap().push(listener);
    }

    /// All events recorded so far (older first).
    pub fn history(&self) -> Vec<Event> {
        self.inner.lock().unwrap().clone()
    }

    /// Events recorded on a given tick.
    pub fn on_tick(&self, tick: u64) -> Vec<Event> {
        self.inner
            .lock()
            .unwrap()
            .iter()
            .filter(|e| e.tick == tick)
            .cloned()
            .collect()
    }

    /// Count events of a kind since engine start.
    pub fn count(&self, kind: EventKind) -> usize {
        self.inner
            .lock()
            .unwrap()
            .iter()
            .filter(|e| e.kind == kind)
            .count()
    }
}

