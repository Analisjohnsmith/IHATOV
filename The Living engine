#[derive(Debug, Clone)]
pub struct LifeNode {
    pub glyph: String,
    pub alive: bool,
}

impl LifeNode {
    pub fn new(alive: bool) -> Self {
        LifeNode {
            glyph: if alive { "•".into() } else { "_".into() },
            alive,
        }
    }

    /// Conway-style transition: survives on 2–3 neighbors, born on exactly 3.
    pub fn next_state(&self, neighbors: &[&LifeNode]) -> LifeNode {
        let alive_neighbors = neighbors.iter().filter(|n| n.alive).count();
        let alive = if self.alive {
            matches!(alive_neighbors, 2 | 3)
        } else {
            alive_neighbors == 3
        };
        let glyph = match (self.alive, alive) {
            (true, true) => "•",
            (false, true) => "+",
            _ => "_",
        };
        LifeNode {
            glyph: glyph.to_string(),
            alive,
        }
    }
}

#[derive(Debug, Clone)]
pub struct CodeNode {
    pub id: String,
    pub code: String,
    pub positions: Vec<OmniPosition>,
    pub meta: HashMap<String, String>,
    pub history: Vec<String>,
    pub life: Option<LifeNode>,
}

impl CodeNode {
    pub fn new(id: impl Into<String>, code: impl Into<String>, life: Option<LifeNode>) -> Self {
        CodeNode {
            id: id.into(),
            code: code.into(),
            positions: Vec::new(),
            meta: HashMap::new(),
            history: Vec::new(),
            life,
        }
    }

    pub fn add_position(&mut self, pos: OmniPosition) {
        if !self.positions.iter().any(|p| {
            p.reality == pos.reality && p.shape == pos.shape && p.coord == pos.coord
        }) {
            self.positions.push(pos);
        }
    }

    pub fn step(&mut self, tick: u64) {
        self.history.push(format!("tick={tick} code={}", self.code));
        if let Some(life) = &self.life {
            self.meta.insert("glyph".into(), life.glyph.clone());
            self.meta.insert("alive".into(), life.alive.to_string());
        }
    }
}

#[derive(Debug, Clone)]
pub struct ShapeSpace {
    pub shape: String,
    pub cells: HashMap<String, Vec<CodeNode>>,
}

impl ShapeSpace {
    pub fn place(&mut self, coord: &str, node: CodeNode) {
        self.cells.entry(coord.to_string()).or_default().push(node);
    }

    pub fn nodes_at(&self, coord: &str) -> Vec<CodeNode> {
        self.cells.get(coord).cloned().unwrap_or_default()
    }
}

#[derive(Debug, Clone)]
pub struct Reality {
    pub id: RealityId,
    pub spaces: HashMap<String, ShapeSpace>,
}

impl Reality {
    pub fn get_space(&mut self, shape: &str) -> &mut ShapeSpace {
        self.spaces
            .entry(shape.to_string())
            .or_insert_with(|| ShapeSpace {
                shape: shape.to_string(),
                cells: HashMap::new(),
            })
    }

    pub fn place_node(&mut self, node: &mut CodeNode, shape: &str, coord: &str) {
        self.get_space(shape).place(coord, node.clone());
        node.add_position(OmniPosition {
            reality: self.id.clone(),
            shape: shape.to_string(),
