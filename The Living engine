/// Assemble the Book of the Living engine: core domains + marrow overlay.
pub fn build_runtime(threads: usize, thoughts: &[String]) -> Result<Runtime, String> {
    let mut rt = Runtime::new(threads);

    let hella = HellaEngine::default_spec()?;
    let kitty = {
        let mut k = KittyOS::new();
        if let Some(first) = thoughts.first() {
            k.set_thought(first);
        }
        k
    };
    let validator = ValidatorSpiral::default_seed()?;
    let marrow = Marrowweave::new();

    rt.register(Box::new(hella));
    rt.register(Box::new(validator));
    rt.register(Box::new(kitty));
    rt.register(Box::new(marrow));
    Ok(rt)
}

// ===========================================================================
// CLI
// ===========================================================================

const USAGE: &str = "\
Book of the Living — RAGE-style Rust engine (living.txt)

USAGE:
  living_engine [OPTIONS] [MODE]

MODES:
  hella       Hella Engine festival validator (default)
  kitty       KittyOS process table
  validator   ValidatorSpiral biology/cosmos map
  marrow      Marrowweave OmniReality + life cellular automaton
  festival    ASCII festival parade through the world grid
  all         Run everything in sequence

OPTIONS:
  --loops N       He is loops for the hella engine (default 1)
  --thought T     KittyOS thought: idle/nap/snack/zoom/purr/stare
  --threads N     Job-scheduler worker threads (default = cores)
  --help          Show this help
";

fn parse_args() -> (String, usize, Option<String>, usize) {
    let mut mode = "hella".to_string();
    let mut loops = 1usize;
    let mut thought: Option<String> = None;
    let mut threads = std::thread::available_parallelism().map(|n| n.get()).unwrap_or(4);

    let mut args = std::env::args().skip(1).peekable();
    while let Some(arg) = args.next() {
        match arg.as_str() {
            "--help" | "-h" => {
                print!("{USAGE}");
                std::process::exit(0);
            }
            "--loops" => {
                loops = args.next().and_then(|v| v.parse().ok()).unwrap_or(1);
            }
            "--thought" => {
                thought = args.next();
            }
            "--threads" => {
                threads = args.next().and_then(|v| v.parse().ok()).unwrap_or(threads);
            }
            "--" => {
                mode = args.next().unwrap_or(mode);
            }
            s if s.starts_with('-') => {
                eprintln!("unknown flag: {s}");
                eprintln!("{USAGE}");
                std::process::exit(1);
            }
            s => {
                mode = s.to_string();
            }
        }
    }
    (mode, loops, thought, threads)
}

fn run_festival(rt: &mut Runtime) -> std::io::Result<()> {
    for cycle in CYCLES {
        let phases = PHASES.iter().find(|(c, _)| *c == *cycle).unwrap().1;
        for phase in phases {
            rt.step(cycle, phase);
        }
    }

    let stdout = std::io::stdout();
    let mut out = stdout.lock();
    writeln!(out, "=== {PD_SEAL} Festival Parade — world state ===")?;
    writeln!(
        out,
        "chunks={}/{} entities={} (stream radius={})",
        rt.world.chunk_count(),
        rt.world.stream_capacity(),
        rt.world.entity_count(),
        rt.world.stream_radius(),
    )?;

    let mut loaded = rt.world.loaded();
    loaded.sort_by(|a, b| a.0.z.cmp(&b.0.z).then(a.0.x.cmp(&b.0.x)));

    let mut drawn: Vec<(String, String)> = Vec::new();
    for (coord, entity) in loaded.iter() {
        let shape = entity
            .data
            .get("object")
            .cloned()
            .map(|o| shape_for_object(&o).to_string())
            .unwrap_or_else(|| entity.shape.clone());
        drawn.push((
            format!("{}{}@x{}y{}", entity.domain, entity.name, coord.x, coord.y),
            shape,
        ));
    }

    // Lay the parade out in rows of five.
    for row in drawn.chunks(5) {
        let arts: Vec<Vec<String>> = row.iter().map(|(_, s)| render_shape(s)).collect();
        for line in 0..5 {
            for art in &arts {
                write!(out, "{}  ", art[line])?;
            }
            writeln!(out)?;
        }
        for (name, _) in row {
            write!(out, "{:<12} ", name)?;
        }
        writeln!(out)?;
        writeln!(out)?;
    }

    writeln!(out, "Cosmic spiral — the festival's clock:")?;
    for line in render_cosmic_spiral(10) {
        writeln!(out, "{line}")?;
    }

    writeln!(
        out,
        "Events: spawn={} streaming={} node_step={} thought={} resonance={}",
        rt.bus.count(EventKind::Spawn),
        rt.bus.count(EventKind::Streaming),
        rt.bus.count(EventKind::NodeStep),
        rt.bus.count(EventKind::Thought),
        rt.bus.count(EventKind::Resonance),
    )?;
    out.flush()
}

fn shape_for_object(object: &str) -> &'static str {
    match object {
        "yin-yang token" => "circle",
        "torii charm" => "square",
        "rose sigil" => "rose",
        "lineage bone" => "line",
        "bolt charm" => "triangle",
        "shell talisman" => "spiral",
        "moon medallion" => "circle_overlap",
        "fractal wand" => "spiral",
        "tie-dye cloth" => "shape_shift",
        _ => "circle",
    }
}

fn main() -> std::io::Result<()> {
    let (mode, loops, thought, threads) = parse_args();
    let thoughts: Vec<String> = thought.iter().cloned().collect();

    let mut rt = build_runtime(threads, &thoughts).unwrap_or_else(|e| {
        eprintln!("failed to load domains: {e}");
        std::process::exit(1);
    });

    match mode.as_str() {
        "hella" => {
            println!("=== {PD_SEAL} Hella Validator (loops={loops}, threads={}) ===", rt.scheduler.threads());
            for _ in 0..loops {
                for cycle in CYCLES {
                    let phases = PHASES.iter().find(|(c, _)| *c == *cycle).unwrap().1;
                    for phase in phases {
                        rt.step(cycle, phase);
                    }
                }
                println!("--- Completion: Tide wash & ritual closure ({PD_SEAL}) ---");
            }
            rt.render_domain("hella")
        }
        "kitty" => rt.render_domain("kitty"),
        "validator" => rt.render_domain("validator"),
        "marrow" => {
            // Advance the cellular automaton a few ticks so it visibly evolves.
            for _ in 0..6 {
                rt.step("cosmic", "Birth");
            }
            rt.render_domain("marrow")
        }
        "festival" => run_festival(&mut rt),
        "all" => {
            for cycle in CYCLES {
                let phases = PHASES.iter().find(|(c, _)| *c == *cycle).unwrap().1;
                for phase in phases {
                    rt.step(cycle, phase);
                }
            }
            rt.render_all()
        }
        other => {
            eprintln!("unknown mode: {other}");
            eprintln!("{USAGE}");
            std::process::exit(1);
        }
    }
}

