impl ValidatorSpiral {
    pub fn load(src: &str) -> Result<Self, String> {
        let doc = parse(src).map_err(|e| e.to_string())?;
        let spiral = doc
            .get("ValidatorSpiral")
            .ok_or_else(|| "missing ValidatorSpiral root".to_string())?;

        let mut core = HashMap::new();
        if let Some(c) = spiral.get("Core").and_then(|v| v.as_object()) {
            for (k, v) in c {
                if let Some(s) = v.as_str() {
                    core.insert(k.clone(), s.to_string());
                }
            }
        }

        let arms: Vec<SpiralArm> = spiral
            .get("SpiralArms")
            .and_then(|v| v.as_array())
            .unwrap_or(&[])
            .iter()
            .filter_map(|a| {
                let t = a.get("Trait").and_then(|v| v.as_str())?;
                Some(SpiralArm {
                    trait_name: t.to_string(),
                    color: a.get("Color").and_then(|v| v.as_str()).unwrap_or("?").to_string(),
                    cell: a.get("Cell").and_then(|v| v.as_str()).unwrap_or("").to_string(),
                    human: a.get("Human").and_then(|v| v.as_str()).unwrap_or("").to_string(),
                    earth: a.get("Earth").and_then(|v| v.as_str()).unwrap_or("").to_string(),
                    cosmos: a.get("Cosmos").and_then(|v| v.as_str()).unwrap_or("").to_string(),
                })
            })
            .collect();

        Ok(ValidatorSpiral {
            core,
            arms,
            mutation: spiral
                .get("Mutation")
                .and_then(|v| v.as_str())
                .unwrap_or("")
                .to_string(),
            aura: spiral
                .get("Aura")
                .and_then(|v| v.as_str())
                .unwrap_or("")
                .to_string(),
            seal: spiral
                .get("Seal")
                .and_then(|v| v.as_str())
                .unwrap_or(PD_SEAL)
                .to_string(),
        })
    }

    pub fn default_seed() -> Result<Self, String> {
        Self::load(include_str!("../assets/validator.hson"))
    }
}

impl Domain for ValidatorSpiral {
    fn id(&self) -> &str {
        "validator"
    }

    fn tick(&self, ctx: &mut DomainContext) -> Vec<WorldOp> {
        ctx.emit(
            EventKind::Resonance,
            self.id(),
            &[("arms", &self.arms.len().to_string()), ("seal", &self.seal)],
        );
        for arm in &self.arms {
            ctx.emit(
                EventKind::Resonance,
                self.id(),
                &[("trait", &arm.trait_name), ("color", &arm.color)],
            );
        }
        Vec::new()
    }

    fn render(&self, out: &mut dyn Write) -> std::io::Result<()> {
        writeln!(out, "{}", banner(&self.seal, "ValidatorSpiral — Biology/Cosmos Map", "map", 0))?;
        writeln!(
            out,
            "Core anchors → Human: {} | Earth: {} | Cosmos: {} | Cell: {}",
            self.core.get("Human").map(|s| s.as_str()).unwrap_or("?"),
            self.core.get("Earth").map(|s| s.as_str()).unwrap_or("?"),
            self.core.get("Cosmos").map(|s| s.as_str()).unwrap_or("?"),
            self.core.get("Cell").map(|s| s.as_str()).unwrap_or("?"),
        )?;
        for a in &self.arms {
            writeln!(
                out,
                "- {:<14} [{:<7}] | Cell: {} | Human: {} | Earth: {} | Cosmos: {}",
                a.trait_name, a.color, a.cell, a.human, a.earth, a.cosmos
            )?;
        }
        if !self.mutation.is_empty() {
            writeln!(out, "Mutation: {}", self.mutation)?;
        }
        if !self.aura.is_empty() {
            writeln!(out, "Aura: {}", self.aura)?;
        }
        Ok(())
    }
}

