pub const CHUNK_SIZE: i32 = 16;
pub const DEFAULT_STREAM_RADIUS: i32 = 2;

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]
pub struct Coord {
    pub x: i32,
    pub y: i32,
    pub z: i32,
}

impl Coord {
    pub fn new(x: i32, y: i32, z: i32) -> Self {
        Coord { x, y, z }
    }
}

#[derive(Debug, Clone)]
pub struct Entity {
    pub id: String,
    pub domain: String,
    pub shape: String,
    pub name: String,
    pub data: HashMap<String, String>,
}

impl Entity {
    pub fn new(id: impl Into<String>, domain: impl Into<String>, name: impl Into<String>) -> Self {
        Entity {
            id: id.into(),
            domain: domain.into(),
            shape: "circle".into(),
            name: name.into(),
            data: HashMap::new(),
        }
    }

    pub fn with_shape(mut self, shape: impl Into<String>) -> Self {
        self.shape = shape.into();
        self
    }

    pub fn with(mut self, key: impl Into<String>, value: impl Into<String>) -> Self {
        self.data.insert(key.into(), value.into());
        self
    }
}

/// World container: a chunked spatial grid of entities with streaming.
#[derive(Default, Clone)]
pub struct World {
    chunks: HashMap<Coord, Vec<Entity>>,
    focus: Coord,
    stream_radius: i32,
    spawned: u64,
}

impl World {
    pub fn new() -> Self {
        Self {
            chunks: HashMap::new(),
            focus: Coord::new(0, 0, 0),
            stream_radius: DEFAULT_STREAM_RADIUS,
            spawned: 0,
        }
    }

    pub fn set_focus(&mut self, coord: Coord) {
        self.focus = coord;
    }

    pub fn focus(&self) -> Coord {
        self.focus
    }

    pub fn stream_radius(&self) -> i32 {
        self.stream_radius
    }

    /// Place an entity at a chunk coordinate. Returns true if in stream range.
    pub fn spawn(&mut self, coord: Coord, entity: Entity, bus: &EventBus, tick: u64) -> bool {
        let in_range = self.in_stream(coord);
        if in_range {
            self.chunks.entry(coord).or_default().push(entity.clone());
            bus.publish(
                Event::new(EventKind::Spawn, "world", tick)
                    .with("entity", entity.id.clone())
                    .with("domain", entity.domain.clone())
                    .with("chunk", format!("{:?}", coord)),
            );
        }
        self.spawned += 1;
        in_range
    }

    /// Remove chunks (streaming unload) that fall out of range.
    pub fn stream(&mut self, bus: &EventBus, tick: u64) {
        let radius = self.stream_radius;
        let focus = self.focus;
        let chunks = std::mem::take(&mut self.chunks);
        let mut kept: HashMap<Coord, Vec<Entity>> = HashMap::new();
        for (coord, entities) in chunks {
            if Self::coord_in_radius(coord, focus, radius) {
                kept.insert(coord, entities);
            } else {
                let names: Vec<String> = entities
                    .iter()
                    .map(|e| format!("{}@{}", e.id, e.domain))
                    .collect();
                bus.publish(
                    Event::new(EventKind::Streaming, "world", tick)
                        .with("action", "unload")
                        .with("chunk", format!("{:?}", coord))
                        .with("entities", names.join(",")),
                );
            }
        }
        self.chunks = kept;
    }

    fn in_stream(&self, coord: Coord) -> bool {
        Self::coord_in_radius(coord, self.focus, self.stream_radius)
    }

    fn coord_in_radius(coord: Coord, focus: Coord, radius: i32) -> bool {
        (coord.x - focus.x).abs() <= radius
            && (coord.y - focus.y).abs() <= radius
            && (coord.z - focus.z).abs() <= radius
    }

    pub fn is_loaded(&self, coord: Coord) -> bool {
        self.chunks.contains_key(&coord)
    }

    pub fn entities_at(&self, coord: Coord) -> &[Entity] {
        self.chunks.get(&coord).map(|v| v.as_slice()).unwrap_or(&[])
    }

    pub fn entity_count(&self) -> usize {
        self.chunks.values().map(|v| v.len()).sum()
    }

    pub fn chunk_count(&self) -> usize {
        self.chunks.len()
    }

    /// Number of chunks that would fit in the stream cube.
    pub fn stream_capacity(&self) -> usize {
        let d = self.stream_radius * 2 + 1;
        (d * d * d) as usize
    }

    /// All loaded entities flattened with their chunk coords.
    pub fn loaded(&self) -> Vec<(Coord, Entity)> {
        self.chunks
            .iter()
            .flat_map(|(c, es)| es.iter().map(move |e| (*c, e.clone())))
            .collect()
    }
}

